---
// src/layouts/BaseLayout.astro
import '@fontsource-variable/inter'
// Subset latino de Inter: se precarga porque es la fuente del titular del hero
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url'
import '@/styles/global.css'
import Schema from '@/components/seo/Schema.astro'
import { SITE } from '@/lib/site.js'

interface Props {
    title?: string
    description?: string
    canonical?: string
}
const {
    title = 'Diseño y desarrollo web en Extremadura — extreweb',
    description = SITE.description,
    canonical,
} = Astro.props

const canonicalURL =
    canonical ?? new URL(Astro.url.pathname, Astro.site ?? SITE.url).href
const ogImage = new URL(SITE.ogImage, SITE.url).href
---

<!doctype html>
<html lang='es'>
    <head>
        <meta charset='UTF-8' />
        <script is:inline>
            ;(function () {
                try {
                    var t = localStorage.getItem('theme')
                    if (
                        t === 'dark' ||
                        (!t &&
                            matchMedia('(prefers-color-scheme: dark)').matches)
                    )
                        document.documentElement.setAttribute(
                            'data-theme',
                            'dark',
                        )
                } catch (e) {}
                var d = document.documentElement
                if (matchMedia('(prefers-reduced-motion: reduce)').matches)
                    return
                d.classList.add('js-motion')
                setTimeout(function () {
                    if (!d.hasAttribute('data-motion-ready'))
                        d.classList.remove('js-motion')
                }, 2500)
            })()
        </script>
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <link
            rel='preload'
            href={interLatin}
            as='font'
            type='font/woff2'
            crossorigin
        />
        <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
        <meta name='generator' content={Astro.generator} />
        <meta
            name='theme-color'
            content='#ffffff'
            media='(prefers-color-scheme: light)'
        />
        <meta
            name='theme-color'
            content='#000000'
            media='(prefers-color-scheme: dark)'
        />
        <meta name='robots' content='index, follow' />

        <title>{title}</title>
        <meta name='description' content={description} />
        <link rel='canonical' href={canonicalURL} />

        <meta property='og:type' content='website' />
        <meta property='og:title' content={title} />
        <meta property='og:description' content={description} />
        <meta property='og:url' content={canonicalURL} />
        <meta property='og:image' content={ogImage} />
        <meta property='og:locale' content='es_ES' />
        <meta property='og:site_name' content='extreweb' />
        <meta name='twitter:card' content='summary_large_image' />
        <meta name='twitter:image' content={ogImage} />

        <Schema />
    </head>
    <body>
        <slot />

        <script>
            // @ts-nocheck
            import '@/lib/motion.js'
        </script>

        <!-- Analítica propia (netlify/functions/visita.mjs → tabla `visitas` → /admin).
             Sin cookies, sin terceros y sin escribir nada en el dispositivo. -->
        <script is:inline define:vars={{ hostAnalitica: new URL(SITE.url).host }}>
            ;(function () {
                try {
                    // Solo en producción: ni local, ni previsualizaciones de Netlify
                    if (location.host !== hostAnalitica) return
                    if (location.pathname.indexOf('/admin') === 0) return
                    if (navigator.webdriver) return

                    var enviar = function () {
                        var cuerpo = JSON.stringify({
                            ruta: location.pathname,
                            ref: document.referrer || '',
                            ancho: window.innerWidth,
                        })
                        navigator.sendBeacon(
                            '/api/visita',
                            new Blob([cuerpo], { type: 'application/json' }),
                        )
                    }

                    // Si el navegador la ha precargado en segundo plano,
                    // se cuenta cuando la persona la mira de verdad
                    if (document.visibilityState === 'hidden')
                        addEventListener('visibilitychange', enviar, { once: true })
                    else enviar()
                } catch (e) {}
            })()
        </script>
    </body>
</html>
