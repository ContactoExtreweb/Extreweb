---
// src/components/Hero.astro
// Titular + oferta, con un anillo 3D de nuestros proyectos girando alrededor.
// El anillo es 100% CSS (sin JS): decorativo, el texto nunca depende de él.
import { SITE } from '@/lib/site.js'
import { PROYECTOS } from '@/lib/proyectos.js'
const { oferta } = SITE

// 10 tarjetas con los 7 proyectos (índices de PROYECTOS; repiten IMTEX, Físicas
// Élite y GuadiCar). Orden pensado para que una web nunca quede enfrente de sí
// misma (la i y la i+5 son distintas) ni junto a sí misma. Si cambia la lista de
// proyectos, revisa este orden.
const anillo = [0, 4, 1, 2, 3, 5, 6, 3, 4, 2].map((n) => PROYECTOS[n].image.replace('.webp', '-800.webp'))
---

<!-- data-anim-pausa: el anillo se para cuando el hero no se ve -->
<section class='hero' data-anim-pausa>
    <div class='hero-glow' aria-hidden='true'></div>

    <div class='container hero-inner'>
        <!-- Anillo 3D (decorativo). Cada tarjeta tiene dos caras: la de fuera
             (la foto) y la de dentro (la misma foto girada 180° y apagada), así
             las de detrás se leen bien y no salen en espejo -->
        <div class='hero-anillo' aria-hidden='true'>
            <!-- .anillo inclina, .giro gira: separados para que el giro no lleve variables (ver CSS) -->
            <div class='anillo'>
                <div class='giro'>
                    {
                        anillo.map((src, i) => (
                            <div class='tarjeta' style={`--i: ${i}`}>
                                <img class='cara' src={src} alt='' width='800' height='400' decoding='async' fetchpriority='low' />
                                <img class='dorso' src={src} alt='' width='800' height='400' decoding='async' fetchpriority='low' />
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>

        {
            oferta && (
                <a href='/contacto/#oferta' class='hero-oferta'>
                    <span class='hero-oferta-tag'>−{oferta.descuento}%</span>
                    <span>en tu web o redes sociales</span>
                    <span aria-hidden='true'>›</span>
                </a>
            )
        }
        <p class='hero-kicker eyebrow'>Diseño y desarrollo web · Extremadura</p>
        <h1 class='hero-title'>
            Vendemos soluciones <span class='hero-grad'>reales</span>.
        </h1>
        <p class='hero-sub'>
            A medida, rápidas y pensadas para vender. Sin plantillas, sin
            atajos.
        </p>
        <div class='hero-actions'>
            <a href='/contacto/' class='btn btn-accent'>Empezar proyecto</a>
            <a href='/proyectos/' class='hero-link'>Ver proyectos&nbsp;›</a>
        </div>
    </div>
</section>

<style>
    .hero {
        /* Geometría del anillo. Móvil: el anillo va DEBAJO de los botones y solo
           se ve la mitad de delante (detrás no hay sitio sin tapar el texto).
           Escritorio, más abajo: rodea todo el texto. */
        --radio: 300px; /* radio del anillo */
        --tw: 170px; /* ancho de cada tarjeta */
        --incl: -12deg; /* inclinación: negativo = lo vemos desde arriba (poca en móvil: la de delante sube) */
        --persp: 1100px;
        /* Móvil: centro del anillo respecto al FINAL del texto (justo bajo los botones).
           Antes iba a 210px del centro del texto: en DevTools (iPhone de 844px de alto)
           se veía, pero en un móvil real, con las barras del navegador, quedaba bajo
           el pliegue y dentro del degradado de abajo */
        --cy: 20px;

        position: relative;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: clamp(96px, 15vh, 150px) var(--pad) clamp(150px, 24vh, 230px);
        overflow: hidden;
    }
    /* Las tarjetas de delante se funden con el fondo en vez de cortarse en seco.
       En móvil, solo el borde (escritorio: 18%): un 18% tapaba justo las tarjetas */
    .hero::after {
        content: '';
        position: absolute;
        inset: auto 0 0;
        height: 40px;
        background: linear-gradient(transparent, var(--bg));
        pointer-events: none;
    }
    .hero-glow {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(
            55% 45% at 50% 6%,
            color-mix(in srgb, var(--accent) 14%, transparent),
            transparent 70%
        );
    }

    .hero-inner {
        position: relative;
        max-width: 880px;
    }
    /* El texto siempre por encima del anillo */
    .hero-inner > :not(.hero-anillo) {
        position: relative;
        z-index: 1;
    }
    .hero-kicker {
        display: inline-block;
        margin-bottom: 1.4rem;
    }

    /* Oferta: pastilla encima del titular (SITE.oferta) */
    .hero-oferta {
        display: flex;
        width: fit-content;
        align-items: center;
        gap: 0.6rem;
        min-height: 44px;
        margin: 0 auto 1.4rem;
        padding: 0.35rem 1rem 0.35rem 0.35rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-pill);
        /* Opaca: por detrás pueden pasar tarjetas del anillo */
        background: var(--surface);
        color: var(--fg);
        font-size: 0.92rem;
        font-weight: 500;
        /* En una línea: Chrome la calculaba ~4px corta y partía el texto */
        white-space: nowrap;
        transition: border-color var(--dur-mid) var(--ease-out-quart);
    }
    @media (max-width: 360px) {
        .hero-oferta {
            font-size: 0.8rem;
            gap: 0.45rem;
        }
    }
    .hero-oferta-tag {
        padding: 0.3rem 0.65rem;
        border-radius: var(--radius-pill);
        background: var(--accent);
        color: var(--accent-fg);
        font-weight: 700;
    }
    .hero-oferta > :last-child {
        color: var(--accent);
        font-size: 1.1rem;
        line-height: 1;
    }
    @media (hover: hover) and (pointer: fine) {
        .hero-oferta:hover {
            border-color: var(--accent);
        }
    }

    .hero-title {
        font-size: clamp(2.6rem, 7.5vw, 5.5rem);
        font-weight: 600;
        letter-spacing: -0.035em;
        line-height: 1.03;
        margin-bottom: 1.6rem;
    }
    .hero-grad {
        background: linear-gradient(120deg, var(--accent), #7c5cff);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: transparent;
    }
    .hero-sub {
        font-size: clamp(1.1rem, 1.8vw, 1.45rem);
        color: var(--muted);
        max-width: 40ch;
        margin: 0 auto 2.2rem;
        line-height: 1.5;
    }
    .hero-actions {
        display: flex;
        gap: 1.3rem;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
    }
    .hero-actions .btn {
        font-size: 1.05rem;
        padding: 0.95rem 2.1rem;
    }
    .hero-link {
        color: var(--accent);
        font-weight: 500;
        font-size: 1.05rem;
    }
    @media (hover: hover) and (pointer: fine) {
        .hero-link:hover {
            text-decoration: underline;
        }
    }

    /* ── ANILLO 3D ──
       Un punto en el centro del bloque de texto con la perspectiva; dentro, el
       anillo inclinado gira sobre su eje vertical. Solo se anima el transform del
       anillo: lo mueve la GPU sin repintar las fotos. */
    .hero-anillo {
        position: absolute;
        left: 50%;
        top: calc(100% + var(--cy)); /* escritorio: 50%, ver más abajo */
        width: 0;
        height: 0;
        perspective: var(--persp);
        pointer-events: none;
        animation: anilloIn 1.6s var(--ease-out-expo) 0.5s both;
    }
    .anillo {
        position: absolute;
        transform-style: preserve-3d;
        transform: rotateX(var(--incl));
    }
    /* El giro va en su propio elemento y con valores FIJOS en los fotogramas (y en la
       duración). Antes era un solo elemento con rotateX(var(--incl)) dentro del
       @keyframes: Chrome lo anima, pero en Safari del iPhone se quedaba quieto */
    .giro {
        position: absolute;
        transform-style: preserve-3d;
        animation: anilloGira 50s linear infinite;
    }
    .tarjeta {
        position: absolute;
        width: var(--tw);
        aspect-ratio: 16 / 10;
        left: calc(var(--tw) / -2);
        top: calc(var(--tw) * -0.3125);
        transform-style: preserve-3d;
        transform: rotateY(calc(var(--i) * 36deg)) translateZ(var(--radio));
    }
    .tarjeta img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: var(--surface);
        backface-visibility: hidden;
    }
    .dorso {
        display: none;
        transform: rotateY(180deg);
        opacity: 0.3;
    }

    @keyframes anilloGira {
        from {
            transform: rotateY(0deg);
        }
        to {
            transform: rotateY(-360deg);
        }
    }
    @keyframes anilloIn {
        from {
            opacity: 0;
            transform: translateY(40px) scale(0.92);
        }
    }

    /* ── Entrada del texto 100% CSS: se reproduce sola al cargar, no se puede romper ── */
    @keyframes heroIn {
        from {
            opacity: 0;
            transform: translateY(26px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .hero-oferta {
        animation: heroIn 0.7s var(--ease-out-quart) 0s both;
    }
    .hero-kicker {
        animation: heroIn 0.7s var(--ease-out-quart) 0.1s both;
    }
    .hero-title {
        animation: heroIn 0.9s var(--ease-out-quart) 0.22s both;
    }
    .hero-sub {
        animation: heroIn 0.9s var(--ease-out-quart) 0.4s both;
    }
    .hero-actions {
        animation: heroIn 0.9s var(--ease-out-quart) 0.55s both;
    }

    /* Escritorio: el anillo rodea el texto (detrás, encima de la pastilla;
       delante, debajo de los botones). Crece con la ALTURA de la pantalla, que es
       lo que manda para que no pise el texto en portátiles bajos */
    @media (min-width: 900px) {
        .hero {
            --radio: clamp(480px, 70vh, 680px);
            --tw: calc(var(--radio) * 0.4);
            --incl: -38deg;
            --persp: 2600px;
            --cy: calc(var(--radio) * -0.02);
            padding-bottom: clamp(140px, 20vh, 220px);
        }
        .hero::after {
            height: 18%;
        }
        .giro {
            animation-duration: 70s;
        }
        .hero-anillo {
            top: calc(50% + var(--cy));
        }
        .dorso {
            display: block;
        }
    }
    /* Portátiles bajos: el texto ya ocupa casi toda la pantalla. Tarjetas algo más
       pequeñas para que no pasen por los botones (1366×768)… */
    @media (min-width: 900px) and (max-height: 780px) {
        .hero {
            --tw: calc(var(--radio) * 0.34);
        }
    }
    /* …y en los muy bajos (1280×650), además, el anillo más inclinado */
    @media (min-width: 900px) and (max-height: 700px) {
        .hero {
            --tw: calc(var(--radio) * 0.3);
            --incl: -44deg;
        }
    }

    /* Reducir movimiento: anillo quieto. Ojo: global.css pone las animaciones a
       0,01 ms, y un giro infinito tan rápido parpadearía */
    @media (prefers-reduced-motion: reduce) {
        .hero-oferta,
        .hero-kicker,
        .hero-title,
        .hero-sub,
        .hero-actions,
        .hero-anillo,
        .giro {
            animation: none;
        }
    }
    @media (max-width: 600px) {
        .hero-title {
            font-size: clamp(2.4rem, 11vw, 3.6rem);
        }
    }
    /* Móvil: algo menos de aire entre líneas para que el anillo quepa en la primera
       pantalla de un móvil real (~664px visibles con las barras del navegador) */
    @media (max-width: 899px) {
        .hero-oferta,
        .hero-kicker {
            margin-bottom: 1rem;
        }
        .hero-title {
            margin-bottom: 1.1rem;
        }
        .hero-sub {
            margin-bottom: 1.6rem;
        }
        .hero-actions {
            row-gap: 0.8rem;
        }
    }
</style>
