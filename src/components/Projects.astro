---
// src/components/Projects.astro
const projects = [
    {
        title: 'CarMeet',
        category: 'Comunidad Automotriz',
        image: '/proyectos/Car-MeetESP.webp',
        link: 'https://carmeet.es',
        color: '#f43f5e'
    },
    {
        title: 'Fichar365',
        category: 'SaaS / RRHH',
        image: '/proyectos/Fichar.webp',
        link: 'https://fichar365.com',
        color: '#3b82f6'
    },
    {
        title: 'Guadicar Multimarcas',
        category: 'Concesionario',
        image: '/proyectos/Guadicar.webp',
        link: 'https://guadicar.es',
        color: '#eab308'
    },
    {
        title: 'Taller M. Guzmán',
        category: 'Automoción',
        image: '/proyectos/Guzman.webp',
        link: 'https://project-r5m3o.vercel.app/',
        color: '#10b981'
    },
    {
        title: 'Toldos Pallares',
        category: 'Web Corporativa',
        image: '/proyectos/Toldos-Pallares.webp',
        link: 'https://toldospallares.com',
        color: '#a855f7'
    }
]
---

<section class='projects' id='proyectos'>
    <div class='container p-head'>
        <span class='eyebrow'>Nuestro Trabajo</span>
        <h2>Proyectos que<br />marcan la diferencia.</h2>
    </div>

    <!-- Con JS, .projects-pin es tan alto como el recorrido horizontal y
         .projects-wrapper se queda fija dentro (sticky) mientras pasan las tarjetas.
         Sin JS o con "reducir movimiento": carrusel nativo que se desliza con el dedo -->
    <div class='projects-pin'>
        <div class='projects-wrapper'>
            <div class='projects-track'>
            
                {projects.map((p, i) => (
                    <!-- Toda la tarjeta es el enlace: así funciona al tocar en móvil
                         (antes el botón solo aparecía con hover) y con teclado -->
                    <a
                        class='project-card'
                        href={p.link}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <div class='p-image'>
                            <img
                                src={p.image}
                                srcset={`${p.image.replace('.webp', '-800.webp')} 800w, ${p.image.replace('.webp', '-1200.webp')} 1200w, ${p.image} 1905w`}
                                sizes='(max-width: 768px) 80vw, (min-width: 1637px) 900px, 55vw'
                                alt={`Web de ${p.title}`}
                                width="1905"
                                height="953"
                                loading="lazy"
                                decoding="async"
                            />
                            <div class='p-overlay' style={`--hover-c: ${p.color}`} aria-hidden="true">
                                <span class='p-btn'>Visitar proyecto</span>
                            </div>
                        </div>
                        <div class='p-info'>
                            <span class='p-cat'>{p.category} <span class='p-ext' aria-hidden="true">↗</span></span>
                            <h3>{p.title}</h3>
                        </div>
                    </a>
                ))}

                <!-- Card final de Call to Action -->
                <div class='projects-end'>
                    <div class='end-content'>
                        <div class='end-icon'>
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 16 16 12 12 8"></polyline><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                        </div>
                        <h3>¿Tienes un proyecto en mente?</h3>
                        <p>Hablemos sobre cómo podemos escalar tu negocio al siguiente nivel.</p>
                        <a href='/proyectos/' class='btn btn-accent btn-large'>Ver todos los proyectos</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<style>
    .projects {
        padding: clamp(80px, 12vh, 140px) 0;
        background: var(--bg);
        overflow: clip; /* recorta el carril; con hidden, el sticky de dentro no funcionaría */
        position: relative;
    }
    
    .p-head {
        margin-bottom: clamp(2rem, 5vh, 4rem);
    }
    .eyebrow {
        color: var(--accent);
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.05em;
        margin-bottom: 0.8rem;
        display: block;
        text-transform: uppercase;
    }
    .p-head h2 {
        font-size: clamp(2.8rem, 6vw, 4.5rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.05;
        color: var(--fg);
    }

    /* --- HORIZONTAL SCROLL TRACK ---
       Por defecto (sin JS o con "reducir movimiento"): carrusel nativo que se
       desliza con el dedo y se imanta a cada tarjeta. */
    .projects-wrapper {
        display: flex;
        align-items: center;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x mandatory;
        padding-block: 1rem 2.5rem; /* sitio para la sombra de las tarjetas */
    }
    .project-card,
    .projects-end {
        scroll-snap-align: center;
    }
    @media (pointer: coarse) {
        .projects-wrapper {
            scrollbar-width: none;
        }
        .projects-wrapper::-webkit-scrollbar {
            display: none;
        }
    }
    /* Con JS, en móvil y en escritorio: la sección se queda fija y las tarjetas
       pasan en horizontal al bajar. Se fija con position: sticky (lo hace el
       navegador, sin los saltos del "pin" de GSAP al entrar y salir).
       El recorrido (--recorrido) lo mide el script */
    :global(html.js-motion) .projects-pin {
        height: calc(100svh + var(--recorrido, 0px));
    }
    :global(html.js-motion) .projects-wrapper {
        position: sticky;
        top: 0;
        height: 100svh;
        overflow: visible;
        scroll-snap-type: none;
        padding-block: 0;
    }
    /* Navegadores con animaciones ligadas al scroll (Chrome, Edge, Safari 26+):
       el carril lo mueve CSS en la GPU, sin JavaScript en cada frame.
       En el resto lo mueve GSAP (ver script) */
    @supports (animation-timeline: view()) {
        :global(html.js-motion) .projects-pin {
            view-timeline: --proyectos block;
        }
        :global(html.js-motion) .projects-track {
            animation: proyectos-x linear both;
            animation-duration: 1ms; /* ignorada con scroll; algunos la exigen > 0 */
            animation-timeline: --proyectos;
            /* del momento en que se fija al momento en que se suelta */
            animation-range: contain 0% contain 100%;
        }
    }
    @keyframes proyectos-x {
        to {
            transform: translateX(calc(-1 * var(--recorrido, 0px)));
        }
    }
    .projects-track {
        display: flex;
        gap: clamp(2rem, 5vw, 6rem);
        padding: 0 10vw; /* Margen inicial para que la primera tarjeta no esté pegada al borde */
        width: max-content;
        align-items: center;
    }

    /* --- CARDS --- */
    .project-card {
        width: 55vw;
        max-width: 900px;
        min-width: 320px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    
    .p-image {
        width: 100%;
        aspect-ratio: 16 / 10;
        border-radius: 24px;
        overflow: hidden;
        position: relative;
        background: var(--surface);
        border: 1px solid var(--border);
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        transform: translateZ(0); /* Forzar aceleración hardware */
    }
    .p-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    /* Overlay y Botón al hacer Hover */
    .p-overlay {
        position: absolute;
        inset: 0;
        background: color-mix(in srgb, var(--hover-c) 20%, rgba(0,0,0,0.4));
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.5s ease;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }
    .p-btn {
        background: #fff;
        color: #000;
        padding: 1rem 2rem;
        border-radius: 100px;
        font-weight: 600;
        font-size: 1.05rem;
        transform: translateY(20px);
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        text-decoration: none;
    }
    html[data-theme='light'] .p-btn {
        background: #000;
        color: #fff;
    }
    
    /* Efectos Hover Desktop */
    @media (hover: hover) and (pointer: fine) {
        .project-card:hover .p-image img {
            transform: scale(1.06);
        }
        .project-card:hover .p-overlay {
            opacity: 1;
        }
        .project-card:hover .p-btn {
            transform: translateY(0);
        }
    }
    /* Teclado: el mismo efecto al llegar con Tab */
    .project-card:focus-visible {
        outline: none;
    }
    .project-card:focus-visible .p-image {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
    }
    .project-card:focus-visible .p-overlay {
        opacity: 1;
    }
    .project-card:focus-visible .p-btn {
        transform: translateY(0);
    }
    .p-image {
        transition: transform var(--dur-fast) var(--ease-out-quart);
    }
    .project-card:active .p-image {
        transform: scale(0.98);
    }
    .p-ext {
        color: var(--accent);
        font-weight: 700;
    }

    .p-info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .p-cat {
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .p-info h3 {
        font-size: clamp(1.8rem, 3vw, 2.5rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--fg);
    }

    /* --- END CARD CTA --- */
    .projects-end {
        width: 40vw;
        min-width: 320px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 4rem;
    }
    .end-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.5rem;
    }
    .end-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: color-mix(in srgb, var(--accent) 15%, transparent);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }
    .end-content h3 {
        font-size: clamp(2rem, 3vw, 3rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        color: var(--fg);
    }
    .end-content p {
        color: var(--muted);
        font-size: 1.15rem;
        max-width: 400px;
        margin-bottom: 1rem;
    }
    .btn-large {
        padding: 1rem 2.5rem;
        font-size: 1.1rem;
    }

    /* --- RESPONSIVE MOBILE --- */
    @media (max-width: 768px) {
        /* 80vw centrada: asoma un trozo de la siguiente para invitar a deslizar */
        .projects-track {
            gap: 1rem;
            padding: 0 10vw;
        }
        .project-card {
            width: 80vw;
            min-width: 0;
        }
        .projects-end {
            width: 80vw;
            min-width: 0;
            padding: 0 1rem;
        }
        .p-btn { display: none; }
    }
</style>

<script>
    // @ts-nocheck
    import { gsap } from '@/lib/motion.js'

    const pin = document.querySelector('.projects-pin')
    const wrapper = pin?.querySelector('.projects-wrapper')
    const track = pin?.querySelector('.projects-track')

    if (pin && wrapper && track) {
        // Las capturas se piden un poco antes de llegar a la sección. Con
        // loading="lazy" solo se pedían al asomar y aparecían de golpe
        // mientras las tarjetas ya iban pasando
        const imgs = track.querySelectorAll('img[loading="lazy"]')
        new IntersectionObserver(
            (entries, io) => {
                if (!entries[0].isIntersecting) return
                imgs.forEach((img) => (img.loading = 'eager'))
                io.disconnect()
            },
            { rootMargin: '100% 0px' },
        ).observe(pin)

        // Con "reducir movimiento" no hay js-motion: se queda el carrusel nativo
        if (document.documentElement.classList.contains('js-motion')) {
            // Recorrido = lo que sobra del carril respecto a la pantalla.
            // Cambia con el ancho de la ventana: se vuelve a medir solo
            const recorrido = () => Math.max(0, track.scrollWidth - wrapper.clientWidth)
            const medir = () => pin.style.setProperty('--recorrido', recorrido() + 'px')
            medir()
            const ro = new ResizeObserver(medir)
            ro.observe(track)
            ro.observe(wrapper)

            // Sin animaciones ligadas al scroll en CSS (Firefox, Safari antiguo): GSAP
            if (!CSS.supports('animation-timeline: view()')) {
                gsap.to(track, {
                    x: () => -recorrido(),
                    ease: 'none',
                    scrollTrigger: {
                        trigger: pin,
                        start: 'top top', // se fija
                        end: 'bottom bottom', // se suelta
                        scrub: 0.4,
                        invalidateOnRefresh: true,
                    },
                })
            }
        }
    }
</script>
