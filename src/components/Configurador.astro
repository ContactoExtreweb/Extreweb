---
// src/components/Configurador.astro
// "¿Cómo quedaría la web de tu negocio?". El visitante monta una web de ejemplo
// (sector, nombre, foto, color, estilo y extras) y la maqueta FUNCIONA: se puede
// pedir cita / reservar / comprar y abrir el WhatsApp, y al lado aparece la
// notificación que le llegaría al dueño. Termina en "Quiero una web así", que abre
// el formulario de contacto con el mensaje ya empezado (vía sessionStorage).
//
// Sin JS se ve completo con el estado inicial: nada se oculta esperando a JavaScript.
// Los estilos van en <style is:global> con prefijo #configurador porque gran parte
// del contenido de la maqueta lo crea el JS (el CSS scoped de Astro no le llegaría).

const I = {
    taller: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
    restaurante: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
    tienda: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
    peluqueria: '<circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12"/><path d="M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/>',
}

const tipos = [
    {
        id: 'taller',
        label: 'Taller',
        articulo: 'un taller',
        icono: I.taller,
        nombre: 'Taller Pérez',
        kicker: 'Taller mecánico',
        titulo: 'Tu coche, como nuevo.',
        sub: 'Chapa, pintura y mecánica con presupuesto sin compromiso.',
        cta: 'Pedir cita',
        lista: [['Revisión completa', 'Aceite y filtros'], ['Chapa y pintura', 'Presupuesto en 24 h'], ['Diagnosis', 'Al momento']],
        info: ['L–V · 8:00–18:00', 'Polígono industrial'],
        opiniones: [['Me dejaron el coche perfecto y en el plazo que dijeron.', 'Antonio R.'], ['Presupuesto claro y sin sorpresas.', 'Lucía M.']],
        chat: ['Hola, ¿tenéis hueco para una revisión esta semana?', '¡Hola! Sí, mañana a las 9:00. ¿Te viene bien?'],
        flujo: {
            titulo: 'Pide tu cita',
            grupos: [
                { k: 'dia', label: 'Día', v: ['Hoy', 'Mañana', 'Viernes'] },
                { k: 'hora', label: 'Hora', v: ['9:00', '11:30', '16:00'] },
            ],
            boton: 'Confirmar cita',
            ok: '¡Cita confirmada!',
            okSub: 'Día: {dia} · Hora: {hora}',
            aviso: 'Nueva cita · {dia}, {hora}',
        },
    },
    {
        id: 'restaurante',
        label: 'Restaurante',
        articulo: 'un restaurante',
        icono: I.restaurante,
        nombre: 'Casa Lucía',
        kicker: 'Restaurante',
        titulo: 'Cocina extremeña de siempre.',
        sub: 'Producto de la tierra y menú del día de lunes a viernes.',
        cta: 'Reservar mesa',
        lista: [['Migas extremeñas', '9,50 €'], ['Presa ibérica', '16 €'], ['Torta del Casar', '12 €']],
        info: ['Hoy · 13:00–16:30', 'Terraza'],
        opiniones: [['Las migas, de las mejores que he probado.', 'Carmen P.'], ['Trato de diez y una terraza muy agradable.', 'Jorge S.']],
        chat: ['Hola, ¿tenéis mesa para 4 el sábado?', '¡Claro! ¿A las 14:30 os viene bien?'],
        flujo: {
            titulo: 'Reserva tu mesa',
            grupos: [
                { k: 'personas', label: 'Personas', v: ['2', '4', '6'] },
                { k: 'hora', label: 'Hora', v: ['13:30', '14:30', '21:00'] },
            ],
            boton: 'Reservar',
            ok: '¡Mesa reservada!',
            okSub: '{personas} personas · {hora}',
            aviso: 'Reserva · {personas} personas, {hora}',
        },
    },
    {
        id: 'tienda',
        label: 'Tienda',
        articulo: 'una tienda',
        icono: I.tienda,
        nombre: 'Moda Elena',
        kicker: 'Tienda online',
        titulo: 'Nueva temporada.',
        sub: 'Compra online y recíbelo en casa o recógelo en tienda.',
        cta: 'Comprar',
        lista: [['Vestido de lino', '39,90 €'], ['Camisa oversize', '29,90 €'], ['Bolso de piel', '59 €']],
        info: ['Envío en 24–48 h', 'Recogida en tienda'],
        opiniones: [['Me llegó en un día y la talla, perfecta.', 'Laura G.'], ['Ropa bonita y atención muy cercana.', 'Isabel T.']],
        chat: ['Hola, ¿tenéis el vestido de lino en la M?', '¡Sí! Te lo guardamos o te lo enviamos hoy mismo.'],
        flujo: {
            titulo: 'Vestido de lino · 39,90 €',
            grupos: [
                { k: 'talla', label: 'Talla', v: ['S', 'M', 'L'] },
                { k: 'entrega', label: 'Entrega', v: ['A domicilio', 'En tienda'] },
            ],
            boton: 'Comprar',
            ok: '¡Pedido recibido!',
            okSub: 'Talla {talla} · {entrega}',
            aviso: 'Nuevo pedido · 39,90 € · talla {talla}',
        },
    },
    {
        id: 'peluqueria',
        label: 'Peluquería',
        articulo: 'una peluquería',
        icono: I.peluqueria,
        nombre: 'Estudio Marta',
        kicker: 'Peluquería y estética',
        titulo: 'Tu cita, en dos toques.',
        sub: 'Reserva online a cualquier hora y recibe un recordatorio.',
        cta: 'Pedir cita',
        lista: [['Corte y peinado', '45 min'], ['Color y mechas', '2 h'], ['Tratamientos', 'Keratina']],
        info: ['Cita online 24 h', 'Martes a sábado'],
        opiniones: [['Reservar desde el móvil es comodísimo.', 'Marta L.'], ['Salgo siempre encantada.', 'Rocío D.']],
        chat: ['Hola, ¿hay hueco el viernes por la tarde?', 'Sí, a las 17:30. ¿Te lo reservo?'],
        flujo: {
            titulo: 'Pide tu cita',
            grupos: [
                { k: 'servicio', label: 'Servicio', v: ['Corte', 'Color', 'Peinado'] },
                { k: 'hora', label: 'Hora', v: ['10:00', '12:30', '17:30'] },
            ],
            boton: 'Confirmar cita',
            ok: '¡Cita confirmada!',
            okSub: '{servicio} · {hora}',
            aviso: 'Nueva cita · {servicio}, {hora}',
        },
    },
]

const colores = [
    { id: 'azul', nombre: 'azul', hex: '#0071e3' },
    { id: 'violeta', nombre: 'violeta', hex: '#6d4aff' },
    { id: 'verde', nombre: 'verde', hex: '#1a8a4c' },
    { id: 'naranja', nombre: 'naranja', hex: '#d9570b' },
    { id: 'rosa', nombre: 'rosa', hex: '#d63a74' },
]

const estilos = [
    { id: 'moderno', nombre: 'moderno', label: 'Moderno' },
    { id: 'clasico', nombre: 'clásico', label: 'Clásico' },
    { id: 'atrevido', nombre: 'atrevido', label: 'Atrevido' },
]

const extras = [
    { id: 'galeria', label: 'Galería', on: true },
    { id: 'opiniones', label: 'Opiniones', on: false },
    { id: 'mapa', label: 'Mapa', on: false },
    { id: 'whatsapp', label: 'WhatsApp', on: true },
]
const extraOn = (id: string) => extras.find((e) => e.id === id)?.on

const t = tipos[0]
const c = colores[0]
const dominio = (n: string) =>
    n.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]/g, '') + '.es'

const check = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>'
---

<section
    class='cfg'
    id='configurador'
    style={`--brand:${c.hex}`}
    data-tipos={JSON.stringify(tipos)}
    data-colores={JSON.stringify(colores)}
    data-estilos={JSON.stringify(estilos)}
    data-extras={JSON.stringify(extras)}
>
    <div class='cfg-glow' aria-hidden='true'></div>

    <div class='container cfg-grid'>
        <!-- ============ CABECERA ============ -->
        <header class='cfg-head'>
            <span class='cfg-eyebrow'>Pruébalo tú</span>
            <h2>¿Cómo quedaría la web de <span class='cfg-grad'>tu negocio</span>?</h2>
            <p class='cfg-sub'>
                Móntala en diez segundos y pruébala: pide una cita, abre el WhatsApp…
                Así empieza cada web que hacemos: con tu negocio, no con una plantilla.
            </p>
        </header>

        <!-- ============ EDITOR ============ -->
        <div class='cfg-editor'>
            <!-- En móvil (con JS) los pasos van en pestañas bajo el teléfono -->
            <div class='cfg-tabs' role='tablist' aria-label='Personaliza tu web'>
                <button type='button' role='tab' data-tab='negocio' aria-selected='true'>Negocio</button>
                <button type='button' role='tab' data-tab='nombre' aria-selected='false'>Nombre</button>
                <button type='button' role='tab' data-tab='estilo' aria-selected='false'>Estilo</button>
                <button type='button' role='tab' data-tab='extras' aria-selected='false'>Extras</button>
            </div>

            <fieldset class='cfg-step is-active' data-panel='negocio'>
                <legend class='cfg-legend'><span class='cfg-num'>1</span>Tu negocio</legend>
                <div class='cfg-chips cfg-chips-4'>
                    {
                        tipos.map((x, i) => (
                            <button type='button' class='cfg-chip' data-tipo={x.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                                <svg viewBox='0 0 24 24' aria-hidden='true' set:html={x.icono} />
                                {x.label}
                            </button>
                        ))
                    }
                </div>
            </fieldset>

            <div class='cfg-step' data-panel='nombre'>
                <label class='cfg-legend' for='cfg-nombre'><span class='cfg-num'>2</span>Nombre y foto</label>
                <div class='cfg-row'>
                    <input
                        id='cfg-nombre'
                        class='cfg-input'
                        type='text'
                        maxlength='24'
                        placeholder={t.nombre}
                        autocomplete='off'
                        spellcheck='false'
                    />
                    <label class='cfg-photo' for='cfg-foto'>
                        <svg viewBox='0 0 24 24' aria-hidden='true'><path d='M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z'/><circle cx='12' cy='13' r='3'/></svg>
                        <span data-foto-label>Añadir foto</span>
                    </label>
                    <input id='cfg-foto' class='cfg-file' type='file' accept='image/*' />
                </div>
                <p class='cfg-hint'>
                    La foto se queda en tu dispositivo, no se sube a ningún sitio.
                    <button type='button' class='cfg-link' data-quitar-foto hidden>Quitar foto</button>
                </p>
            </div>

            <fieldset class='cfg-step' data-panel='estilo'>
                <legend class='cfg-legend'><span class='cfg-num'>3</span>Color y estilo</legend>
                <div class='cfg-swatches'>
                    {
                        colores.map((x, i) => (
                            <button
                                type='button'
                                class='cfg-sw'
                                data-color={x.id}
                                style={`--c:${x.hex}`}
                                aria-pressed={i === 0 ? 'true' : 'false'}
                                aria-label={`Color ${x.nombre}`}
                            />
                        ))
                    }
                </div>
                <div class='cfg-chips cfg-styles'>
                    {
                        estilos.map((x, i) => (
                            <button type='button' class={`cfg-chip cfg-style st-${x.id}`} data-estilo={x.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                                <span class='cfg-aa' aria-hidden='true'>Aa</span>
                                {x.label}
                            </button>
                        ))
                    }
                </div>
            </fieldset>

            <fieldset class='cfg-step' data-panel='extras'>
                <legend class='cfg-legend'><span class='cfg-num'>4</span>Extras</legend>
                <div class='cfg-chips cfg-chips-4'>
                    {
                        extras.map((x) => (
                            <button type='button' class='cfg-chip cfg-toggle' data-extra={x.id} aria-pressed={x.on ? 'true' : 'false'}>
                                <span class='cfg-tick' aria-hidden='true' set:html={check} />
                                {x.label}
                            </button>
                        ))
                    }
                </div>
            </fieldset>

            <button type='button' class='cfg-dice' data-dado>
                <svg viewBox='0 0 24 24' aria-hidden='true'><rect x='3' y='3' width='18' height='18' rx='4'/><circle cx='8.5' cy='8.5' r='1.2'/><circle cx='15.5' cy='15.5' r='1.2'/><circle cx='15.5' cy='8.5' r='1.2'/><circle cx='8.5' cy='15.5' r='1.2'/><circle cx='12' cy='12' r='1.2'/></svg>
                Sorpréndeme
            </button>
        </div>

        <!-- ============ MAQUETA ============ -->
        <div class='cfg-stage'>
            <div class='cfg-seg' role='group' aria-label='Ver la maqueta en'>
                <button type='button' data-device='phone' aria-pressed='true'>Móvil</button>
                <button type='button' data-device='desktop' aria-pressed='false'>Ordenador</button>
            </div>

            <!-- Notificación "que te llega a ti" -->
            <div class='cfg-toast' role='status' aria-live='polite'></div>
            <p class='cfg-sr' aria-live='polite' id='cfg-live'></p>

            <div class='cfg-device is-phone'>
                <div class='cfg-bar' aria-hidden='true'>
                    <i></i><i></i><i></i>
                    <span class='cfg-url' data-m='url'>{dominio(t.nombre)}</span>
                </div>
                <div
                    class='cfg-screen est-moderno'
                    role='group'
                    aria-label='Vista previa interactiva de la web'
                >
                    <div class='m-scroll' data-lenis-prevent>
                        <div class='m-status' aria-hidden='true'>
                            <span>9:41</span><span class='m-island'></span><span class='m-batt'></span>
                        </div>
                        <header class='m-nav'>
                            <span class='m-logo' data-m='inicial' aria-hidden='true'>{t.nombre[0]}</span>
                            <b class='m-name' data-m='nombre'>{t.nombre}</b>
                            <span class='m-links' aria-hidden='true'><span>Servicios</span><span>Nosotros</span><span>Contacto</span></span>
                            <span class='m-burger' aria-hidden='true'><i></i><i></i></span>
                        </header>

                        <div class='m-hero'>
                            <div class='m-art' data-m='art'>
                                <svg viewBox='0 0 24 24' data-m='icono' aria-hidden='true' set:html={t.icono} />
                            </div>
                            <div class='m-copy'>
                                <span class='m-kicker' data-m='kicker'>{t.kicker}</span>
                                <!-- El nombre del negocio es el protagonista -->
                                <b class='m-brand'><span data-m='marca'>{t.nombre}</span><i class='m-caret' aria-hidden='true'></i></b>
                                <span class='m-title' data-m='titulo'>{t.titulo}</span>
                                <span class='m-sub' data-m='sub'>{t.sub}</span>
                                <button type='button' class='m-cta' data-accion='flujo'>
                                    <span data-m='cta'>{t.cta}</span>
                                </button>
                            </div>
                        </div>

                        <div class='m-list' data-m='lista'>
                            {t.lista.map(([a, b]) => <span class='m-item'><b>{a}</b><span>{b}</span></span>)}
                        </div>

                        <section class='m-block' data-block='galeria' hidden={!extraOn('galeria')}>
                            <b class='m-h'>Galería</b>
                            <div class='m-gallery'>
                                <span class='m-tile m-tile-1' data-m='tile'></span>
                                <span class='m-tile m-tile-2'></span>
                                <span class='m-tile m-tile-3'></span>
                                <span class='m-tile m-tile-4'></span>
                            </div>
                        </section>

                        <section class='m-block' data-block='opiniones' hidden={!extraOn('opiniones')}>
                            <b class='m-h'>Opiniones</b>
                            <div class='m-reviews'>
                                {
                                    t.opiniones.map(([txt, autor], i) => (
                                        <figure class='m-review'>
                                            <span class='m-stars' aria-label='5 estrellas'>★★★★★</span>
                                            <blockquote data-m={`op${i}`}>{txt}</blockquote>
                                            <figcaption data-m={`au${i}`}>{autor}</figcaption>
                                        </figure>
                                    ))
                                }
                            </div>
                        </section>

                        <section class='m-block' data-block='mapa' hidden={!extraOn('mapa')}>
                            <b class='m-h'>Dónde estamos</b>
                            <div class='m-map' aria-hidden='true'>
                                <i class='m-road m-road-1'></i><i class='m-road m-road-2'></i><i class='m-road m-road-3'></i>
                                <span class='m-pin'></span>
                            </div>
                            <button type='button' class='m-btn2' data-accion='mapa'>Cómo llegar</button>
                        </section>

                        <div class='m-info' data-m='info'>
                            {t.info.map((x) => <span>{x}</span>)}
                        </div>
                    </div>

                    <!-- Burbuja de WhatsApp -->
                    <button
                        type='button'
                        class:list={['m-wa', { 'is-on': extraOn('whatsapp') }]}
                        data-accion='chat'
                        aria-label='Abrir WhatsApp'
                    >
                        <svg viewBox='0 0 24 24' aria-hidden='true'><path d='M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.5 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.6-.1 1.1Z'/></svg>
                    </button>

                    <!-- Hoja inferior: reserva / compra / chat -->
                    <div class='m-sheet' inert>
                        <div class='m-sheet-card' role='dialog' aria-modal='true' aria-label='Proceso de reserva'></div>
                    </div>
                </div>
            </div>

            <p class='cfg-tip'>
                <span class='cfg-tip-dot' aria-hidden='true'></span>
                <span>Es interactiva: toca «<span data-m='tipcta'>{t.cta}</span>»<span data-m='tipwa' hidden={!extraOn('whatsapp')}> o el WhatsApp</span>.</span>
            </p>
        </div>

        <!-- ============ LLAMADA A LA ACCIÓN ============ -->
        <div class='cfg-cta-wrap'>
            <a href='/contacto/' class='btn cfg-cta' id='cfg-cta'>
                Quiero una web así <span aria-hidden='true'>→</span>
            </a>
            <p class='cfg-note'>Sin compromiso. Te respondemos en menos de 24 horas.</p>
        </div>
    </div>
</section>

<style is:global>
    /* Registrar --brand como color permite animarlo (degradados incluidos) */
    @property --brand {
        syntax: '<color>';
        inherits: true;
        initial-value: #0071e3;
    }

    /* ================= SECCIÓN ================= */
    #configurador {
        position: relative;
        /* clip (no hidden): recorta el brillo sin crear un contenedor de scroll,
           que rompería el position: sticky de la maqueta */
        overflow: clip;
        background: var(--bg);
        transition: --brand 0.5s var(--ease-out-quart);
    }
    #configurador .cfg-glow {
        position: absolute;
        right: -10%;
        top: 22%;
        width: 700px;
        height: 700px;
        border-radius: 50%;
        background: radial-gradient(circle, color-mix(in srgb, var(--brand) 32%, transparent), transparent 62%);
        filter: blur(40px);
        opacity: 0.55;
        pointer-events: none;
    }
    html[data-theme='light'] #configurador .cfg-glow {
        opacity: 0.35;
    }

    /* Móvil: cabecera → maqueta → editor → botón. Escritorio: editor izquierda, maqueta derecha */
    #configurador .cfg-grid {
        position: relative;
        display: grid;
        gap: 1.75rem;
        grid-template-areas: 'head' 'stage' 'editor' 'cta';
    }
    #configurador .cfg-head { grid-area: head; }
    #configurador .cfg-editor { grid-area: editor; }
    #configurador .cfg-stage { grid-area: stage; }
    #configurador .cfg-cta-wrap { grid-area: cta; }
    /* --- Cabecera --- */
    #configurador .cfg-eyebrow {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brand);
        margin-bottom: 0.9rem;
    }
    #configurador .cfg-head h2 {
        font-size: clamp(2rem, 5vw, 3.4rem);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1.05;
    }
    #configurador .cfg-grad {
        color: var(--brand);
    }
    #configurador .cfg-sub {
        margin-top: 1rem;
        font-size: clamp(1.02rem, 1.6vw, 1.15rem);
        line-height: 1.6;
        color: var(--muted);
        max-width: 48ch;
    }

    /* ================= EDITOR ================= */
    #configurador .cfg-editor {
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
    }
    #configurador .cfg-tabs {
        display: none;
    }
    /* Con JS y en pantallas estrechas: pestañas (una sección visible cada vez) */
    @media (max-width: 999px) {
        #configurador.cfg-js .cfg-editor {
            gap: 1rem;
        }
        #configurador.cfg-js .cfg-tabs {
            display: flex;
            padding: 3px;
            border-radius: var(--radius-pill);
            background: var(--surface);
            border: 1px solid var(--border);
        }
        #configurador.cfg-js .cfg-step:not(.is-active) {
            display: none;
        }
        #configurador.cfg-js .cfg-step {
            min-height: 112px;
        }
        #configurador.cfg-js .cfg-legend {
            display: none; /* la pestaña ya dice qué se edita */
        }
    }
    #configurador .cfg-tabs button {
        flex: 1;
        min-height: 40px;
        border-radius: var(--radius-pill);
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--muted);
        transition:
            background var(--dur-mid) var(--ease-out-quart),
            color var(--dur-mid) var(--ease-out-quart);
    }
    #configurador .cfg-tabs button[aria-selected='true'] {
        background: var(--bg);
        color: var(--fg);
        box-shadow: var(--shadow);
    }

    #configurador .cfg-step {
        border: 0;
        margin: 0;
        padding: 0;
        min-width: 0;
        animation: cfgIn var(--dur-slow) var(--ease-out-quart);
    }
    @keyframes cfgIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
    }
    #configurador .cfg-legend {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--fg);
        margin-bottom: 0.7rem;
        padding: 0;
    }
    #configurador .cfg-num {
        display: grid;
        place-items: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        font-size: 0.72rem;
        font-weight: 700;
        color: #fff;
        background: var(--brand);
    }

    #configurador .cfg-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    #configurador .cfg-chips-4 {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }
    @media (min-width: 560px) {
        #configurador .cfg-chips-4 {
            display: flex;
        }
    }
    #configurador .cfg-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-height: 46px;
        padding: 0.55rem 1.05rem;
        border-radius: var(--radius-pill);
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--fg);
        font-size: 0.95rem;
        font-weight: 500;
        transition:
            border-color var(--dur-mid) var(--ease-out-quart),
            background var(--dur-mid) var(--ease-out-quart),
            transform var(--dur-fast) var(--ease-out-quart);
    }
    #configurador .cfg-chip svg {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        color: var(--muted);
        transition: color var(--dur-mid) var(--ease-out-quart);
    }
    #configurador .cfg-chip:active {
        transform: scale(0.96);
    }
    #configurador .cfg-chip[aria-pressed='true'] {
        border-color: var(--brand);
        background: color-mix(in srgb, var(--brand) 12%, var(--bg));
    }
    #configurador .cfg-chip[aria-pressed='true'] svg {
        color: var(--brand);
    }
    @media (hover: hover) and (pointer: fine) {
        #configurador .cfg-chip:hover {
            border-color: color-mix(in srgb, var(--brand) 60%, var(--border));
        }
    }

    /* Extras: casilla que se marca */
    #configurador .cfg-tick {
        display: grid;
        place-items: center;
        width: 18px;
        height: 18px;
        border-radius: 6px;
        border: 1.5px solid var(--border);
        transition:
            background var(--dur-mid) var(--ease-out-quart),
            border-color var(--dur-mid) var(--ease-out-quart);
    }
    #configurador .cfg-tick svg {
        width: 12px;
        height: 12px;
        fill: none;
        stroke: #fff;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 3;
        opacity: 0;
        transform: scale(0.5);
        transition:
            opacity var(--dur-fast) var(--ease-out-quart),
            transform var(--dur-mid) var(--ease-out-quart);
    }
    #configurador .cfg-toggle[aria-pressed='true'] .cfg-tick {
        background: var(--brand);
        border-color: var(--brand);
    }
    #configurador .cfg-toggle[aria-pressed='true'] .cfg-tick svg {
        opacity: 1;
        transform: none;
    }

    /* Estilos: "Aa" con la tipografía de cada uno */
    #configurador .cfg-styles {
        margin-top: 0.8rem;
    }
    #configurador .cfg-aa {
        font-weight: 700;
        font-size: 1rem;
        color: var(--brand);
    }
    #configurador .st-clasico .cfg-aa {
        font-family: ui-serif, 'New York', Georgia, 'Times New Roman', serif;
        font-weight: 600;
    }
    #configurador .st-atrevido .cfg-aa {
        font-weight: 900;
        text-transform: uppercase;
    }

    #configurador .cfg-row {
        display: flex;
        gap: 0.6rem;
        align-items: stretch;
    }
    #configurador .cfg-input {
        flex: 1;
        min-width: 0;
        min-height: 48px;
        padding: 0.75rem 1rem;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--fg);
        font: inherit;
        font-size: 1rem; /* 16px: iOS no hace zoom al enfocar */
        transition:
            border-color var(--dur-mid) var(--ease-out-quart),
            box-shadow var(--dur-mid) var(--ease-out-quart);
    }
    #configurador .cfg-input::placeholder {
        color: var(--muted);
    }
    #configurador .cfg-input:focus {
        outline: none;
        border-color: var(--brand);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--brand) 20%, transparent);
    }
    #configurador .cfg-photo {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        flex-shrink: 0;
        padding: 0 1rem;
        min-height: 48px;
        border-radius: var(--radius);
        border: 1px dashed color-mix(in srgb, var(--brand) 55%, var(--border));
        color: var(--fg);
        font-size: 0.92rem;
        font-weight: 500;
        cursor: pointer;
        transition: background var(--dur-mid) var(--ease-out-quart);
    }
    #configurador .cfg-photo svg {
        width: 18px;
        height: 18px;
        fill: none;
        stroke: var(--brand);
        stroke-width: 2;
        stroke-linejoin: round;
    }
    #configurador .cfg-photo:active {
        transform: scale(0.97);
    }
    @media (hover: hover) and (pointer: fine) {
        #configurador .cfg-photo:hover {
            background: color-mix(in srgb, var(--brand) 8%, transparent);
        }
    }
    #configurador .cfg-file {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }
    /* El input de archivo está oculto: el foco de teclado se enseña en su botón */
    #configurador .cfg-row:has(.cfg-file:focus-visible) .cfg-photo {
        outline: 2px solid var(--brand);
        outline-offset: 2px;
    }
    #configurador .cfg-hint {
        margin-top: 0.55rem;
        font-size: 0.8rem;
        color: var(--muted);
    }
    #configurador .cfg-link {
        color: var(--brand);
        font-weight: 600;
        margin-left: 0.3rem;
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    #configurador .cfg-link[hidden] {
        display: none;
    }

    #configurador .cfg-swatches {
        display: flex;
        gap: 0.7rem;
    }
    #configurador .cfg-sw {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: var(--c);
        border: 3px solid var(--bg);
        box-shadow: 0 0 0 1px var(--border);
        transition:
            transform var(--dur-fast) var(--ease-out-quart),
            box-shadow var(--dur-mid) var(--ease-out-quart);
    }
    #configurador .cfg-sw:active {
        transform: scale(0.9);
    }
    #configurador .cfg-sw[aria-pressed='true'] {
        box-shadow: 0 0 0 2px var(--c);
    }
    @media (hover: hover) and (pointer: fine) {
        #configurador .cfg-sw:hover {
            transform: scale(1.1);
        }
    }

    #configurador .cfg-dice {
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 44px;
        padding: 0.5rem 1rem 0.5rem 0.75rem;
        border-radius: var(--radius-pill);
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--brand);
        background: color-mix(in srgb, var(--brand) 10%, transparent);
        transition: transform var(--dur-fast) var(--ease-out-quart);
    }
    #configurador .cfg-dice svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
    }
    #configurador .cfg-dice svg circle {
        fill: currentColor;
        stroke: none;
    }
    #configurador .cfg-dice:active {
        transform: scale(0.96);
    }
    #configurador .cfg-dice.is-rolling svg {
        animation: cfgRoll 0.5s var(--ease-out-quart);
    }
    @keyframes cfgRoll {
        to {
            transform: rotate(360deg);
        }
    }
    @media (max-width: 999px) {
        #configurador .cfg-dice {
            align-self: center;
        }
    }

    /* ================= ESCENARIO ================= */
    #configurador .cfg-stage {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }
    /* Escritorio: la maqueta acompaña mientras bajas por los pasos */
    @media (min-width: 1000px) {
        #configurador .cfg-stage {
            position: sticky;
            top: 90px;
        }
    }
    #configurador .cfg-seg {
        display: none; /* en móvil solo tiene sentido la vista de móvil */
        padding: 3px;
        border-radius: var(--radius-pill);
        background: var(--surface);
        border: 1px solid var(--border);
    }
    @media (min-width: 760px) {
        #configurador .cfg-seg {
            display: inline-flex;
        }
    }
    #configurador .cfg-seg button {
        min-height: 36px;
        padding: 0.35rem 1.1rem;
        border-radius: var(--radius-pill);
        font-size: 0.88rem;
        font-weight: 500;
        color: var(--muted);
        transition:
            background var(--dur-mid) var(--ease-out-quart),
            color var(--dur-mid) var(--ease-out-quart);
    }
    #configurador .cfg-seg button[aria-pressed='true'] {
        background: var(--bg);
        color: var(--fg);
        box-shadow: var(--shadow);
    }
    #configurador .cfg-sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }
    #configurador .cfg-tip {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--muted);
        text-align: center;
    }
    #configurador .cfg-tip-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--brand);
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--brand) 60%, transparent);
        animation: cfgPing 1.8s infinite;
    }
    @keyframes cfgPing {
        70% {
            box-shadow: 0 0 0 8px transparent;
        }
    }

    /* Notificación "así te avisa tu web" */
    #configurador .cfg-toast {
        position: absolute;
        top: 0;
        left: 50%;
        z-index: 20;
        width: min(330px, calc(100% - 1rem));
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 0.9rem;
        border-radius: 18px;
        background: color-mix(in srgb, var(--surface) 88%, transparent);
        backdrop-filter: saturate(180%) blur(18px);
        -webkit-backdrop-filter: saturate(180%) blur(18px);
        border: 1px solid var(--border);
        box-shadow: var(--shadow-lg);
        opacity: 0;
        transform: translate(-50%, -16px) scale(0.96);
        pointer-events: none;
        transition:
            opacity 0.3s var(--ease-out-quart),
            transform 0.45s var(--ease-out-quint);
    }
    #configurador .cfg-toast.is-on {
        opacity: 1;
        transform: translate(-50%, 0) scale(1);
    }
    @media (min-width: 760px) {
        #configurador .cfg-toast {
            top: 3.2rem;
        }
    }
    #configurador .cfg-toast-ic {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: var(--brand);
        color: #fff;
        font-weight: 800;
    }
    #configurador .cfg-toast-txt {
        display: flex;
        flex-direction: column;
        min-width: 0;
        font-size: 0.85rem;
        line-height: 1.35;
    }
    #configurador .cfg-toast-txt small {
        font-size: 0.72rem;
        color: var(--muted);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    #configurador .cfg-toast-txt b {
        font-weight: 600;
        color: var(--fg);
    }

    /* --- Dispositivo --- */
    #configurador .cfg-device {
        --w: 220px;
        position: relative;
        width: var(--w);
        max-width: 100%;
        height: calc(var(--w) * 2.05);
        padding: 8px;
        border-radius: 42px;
        background: #0b0b0c;
        box-shadow:
            0 0 0 1px var(--border),
            0 40px 80px -30px color-mix(in srgb, var(--brand) 45%, rgba(0, 0, 0, 0.5));
        display: flex;
        flex-direction: column;
        transition:
            width 0.55s var(--ease-out-quint),
            height 0.55s var(--ease-out-quint),
            padding 0.55s var(--ease-out-quint),
            border-radius 0.55s var(--ease-out-quint),
            background 0.55s var(--ease-out-quint);
    }
    @media (min-width: 400px) {
        #configurador .cfg-device { --w: 245px; }
    }
    @media (min-width: 1000px) {
        #configurador .cfg-device { --w: 290px; }
    }
    html[data-theme='dark'] #configurador .cfg-device {
        box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.14),
            0 40px 90px -30px color-mix(in srgb, var(--brand) 55%, transparent);
    }
    #configurador .cfg-device.is-desktop {
        width: 640px;
        height: 430px;
        padding: 0;
        border-radius: 14px;
        background: #e8e8ed;
    }
    html[data-theme='dark'] #configurador .cfg-device.is-desktop {
        background: #2c2c2e;
    }
    #configurador .cfg-bar {
        display: none;
        align-items: center;
        gap: 6px;
        height: 34px;
        padding: 0 12px;
        flex-shrink: 0;
    }
    #configurador .is-desktop .cfg-bar {
        display: flex;
    }
    #configurador .cfg-bar i {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #ff5f57;
    }
    #configurador .cfg-bar i:nth-child(2) { background: #febc2e; }
    #configurador .cfg-bar i:nth-child(3) { background: #28c840; }
    #configurador .cfg-url {
        margin: 0 auto;
        padding: 3px 14px;
        border-radius: 6px;
        font-size: 11px;
        color: #6e6e73;
        background: rgba(255, 255, 255, 0.7);
    }
    html[data-theme='dark'] #configurador .cfg-url {
        background: rgba(255, 255, 255, 0.08);
        color: #a1a1a6;
    }

    /* ================= LA WEB DEL CLIENTE (maqueta) =================
       Variables por estilo; tamaños en cqi para que escale con la pantalla. */
    #configurador .cfg-screen {
        --m-bg: #ffffff;
        --m-fg: #1d1d1f;
        --m-muted: #6e6e73;
        --m-card: #f5f5f7;
        --m-line: #ececef;
        --m-r: 1;
        --m-tf: var(--font);
        --m-tw: 800;
        --m-tt: none;
        --m-tls: -0.035em;
        container-type: inline-size;
        position: relative;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 34px;
        background: var(--m-bg);
        color: var(--m-fg);
        transition:
            border-radius 0.55s var(--ease-out-quint),
            background 0.4s ease,
            color 0.4s ease,
            opacity 0.16s ease;
    }
    #configurador .cfg-screen.est-clasico {
        --m-bg: #fbf8f3;
        --m-fg: #2b2620;
        --m-muted: #7a6f63;
        --m-card: #f1ebe1;
        --m-line: #e8e0d3;
        --m-r: 0.45;
        --m-tf: ui-serif, 'New York', Georgia, 'Times New Roman', serif;
        --m-tw: 600;
        --m-tls: -0.01em;
    }
    #configurador .cfg-screen.est-atrevido {
        --m-bg: #0e0e10;
        --m-fg: #f5f5f7;
        --m-muted: #a1a1a6;
        --m-card: #1c1c1f;
        --m-line: #26262a;
        --m-r: 0.15;
        --m-tw: 900;
        --m-tt: uppercase;
        --m-tls: -0.02em;
    }
    #configurador .is-desktop .cfg-screen {
        border-radius: 0 0 14px 14px;
    }
    #configurador .is-swapping .cfg-screen {
        opacity: 0;
    }
    #configurador .m-scroll {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        scrollbar-width: none;
    }
    #configurador .m-scroll::-webkit-scrollbar {
        display: none;
    }
    #configurador .m-fade {
        animation: mFade 0.35s var(--ease-out-quart);
    }
    @keyframes mFade {
        from {
            opacity: 0;
            transform: translateY(4px);
        }
    }

    #configurador .m-status {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 3.4cqi 7cqi 0;
        font-size: 4.2cqi;
        font-weight: 600;
    }
    #configurador .m-island {
        width: 26cqi;
        height: 7.5cqi;
        border-radius: 99px;
        background: #0b0b0c;
    }
    #configurador .m-batt {
        width: 7.5cqi;
        height: 3.6cqi;
        border-radius: 1cqi;
        border: 0.6cqi solid currentColor;
        opacity: 0.85;
    }
    #configurador .m-nav {
        position: sticky;
        top: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 2.6cqi;
        padding: 4cqi 5.5cqi;
        background: color-mix(in srgb, var(--m-bg) 92%, transparent);
        border-bottom: 1px solid var(--m-line);
    }
    #configurador .m-logo {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 9.5cqi;
        height: 9.5cqi;
        border-radius: calc(2.8cqi * var(--m-r));
        background: var(--brand);
        color: #fff;
        font-size: 5cqi;
        font-weight: 800;
        font-family: var(--m-tf);
    }
    #configurador .m-name {
        flex: 1;
        min-width: 0;
        font-family: var(--m-tf);
        font-size: 5cqi;
        font-weight: 800;
        letter-spacing: -0.02em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    #configurador .m-links {
        display: none;
    }
    #configurador .m-burger {
        display: flex;
        flex-direction: column;
        gap: 1.2cqi;
    }
    #configurador .m-burger i {
        width: 5.5cqi;
        height: 0.7cqi;
        border-radius: 1cqi;
        background: currentColor;
    }
    #configurador .m-hero {
        display: flex;
        flex-direction: column;
        gap: 4.5cqi;
        padding: 5cqi 5.5cqi 4.5cqi;
    }
    #configurador .m-art {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        height: 36cqi;
        border-radius: calc(5cqi * var(--m-r));
        background-color: var(--brand);
        background-image:
            radial-gradient(120% 90% at 85% 10%, color-mix(in srgb, var(--brand) 40%, #fff), transparent 60%),
            linear-gradient(140deg, var(--brand), color-mix(in srgb, var(--brand) 55%, #000));
        background-size: cover;
        background-position: center;
        color: rgba(255, 255, 255, 0.92);
    }
    #configurador .m-art svg {
        width: 15cqi;
        height: 15cqi;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.6;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    #configurador .m-art.has-foto svg {
        display: none;
    }
    #configurador .m-copy {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }
    #configurador .m-kicker {
        font-size: 3.2cqi;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--brand);
    }
    #configurador .est-atrevido .m-kicker {
        color: color-mix(in srgb, var(--brand) 55%, #fff);
    }
    /* Nombre del negocio: el titular de la web */
    #configurador .m-brand {
        display: block;
        margin: 1.4cqi -1.2cqi 1.6cqi;
        padding: 0 1.2cqi;
        border-radius: calc(2cqi * var(--m-r) + 0.6cqi);
        font-family: var(--m-tf);
        font-size: 11.5cqi;
        font-weight: var(--m-tw);
        line-height: 1.02;
        letter-spacing: var(--m-tls);
        text-transform: var(--m-tt);
        overflow-wrap: anywhere;
        transition:
            background 0.25s ease,
            box-shadow 0.25s ease;
    }
    #configurador .m-caret {
        display: inline-block;
        width: 0.7cqi;
        height: 0.85em;
        margin-left: 0.8cqi;
        vertical-align: -0.06em;
        border-radius: 0.3cqi;
        background: var(--brand);
        opacity: 0;
    }
    #configurador .m-brand.is-typing .m-caret,
    #configurador .cfg-screen.is-editing .m-caret {
        opacity: 1;
        animation: mBlink 1s steps(1) infinite;
    }
    @keyframes mBlink {
        50% {
            opacity: 0;
        }
    }
    /* Mientras escribes el nombre, se resalta dentro de la web */
    #configurador .cfg-screen.is-editing .m-brand {
        background: color-mix(in srgb, var(--brand) 12%, transparent);
        box-shadow: 0 0 0 0.5cqi color-mix(in srgb, var(--brand) 35%, transparent);
    }
    /* Eslogan: debajo del nombre, en el color de la marca */
    #configurador .m-title {
        display: block;
        margin: 0 0 2cqi;
        font-family: var(--m-tf);
        font-size: 5.4cqi;
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: color-mix(in srgb, var(--brand) 78%, var(--m-fg));
    }
    #configurador .est-atrevido .m-title {
        color: color-mix(in srgb, var(--brand) 45%, #fff);
    }
    #configurador .m-sub {
        font-size: 3.9cqi;
        line-height: 1.45;
        color: var(--m-muted);
    }
    #configurador .m-cta {
        margin-top: 4cqi;
        padding: 2.8cqi 5.6cqi;
        border-radius: calc(99px * var(--m-r) + 1.2cqi);
        background: var(--brand);
        color: #fff;
        font-size: 3.9cqi;
        font-weight: 600;
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--brand) 55%, transparent);
        animation: mPulse 2.4s infinite 1.5s;
        transition: transform var(--dur-fast) var(--ease-out-quart);
    }
    #configurador .m-cta:active {
        transform: scale(0.95);
    }
    @keyframes mPulse {
        0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--brand) 55%, transparent); }
        70%, 100% { box-shadow: 0 0 0 3cqi transparent; }
    }
    #configurador .m-list {
        display: grid;
        gap: 2.2cqi;
        padding: 0 5.5cqi;
    }
    #configurador .m-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2cqi;
        padding: 3.2cqi 3.8cqi;
        border-radius: calc(3.6cqi * var(--m-r));
        background: var(--m-card);
        font-size: 3.7cqi;
    }
    #configurador .m-item b {
        font-weight: 600;
    }
    #configurador .m-item span {
        color: color-mix(in srgb, var(--brand) 80%, var(--m-fg));
        font-weight: 600;
        white-space: nowrap;
    }
    #configurador .m-block {
        padding: 6cqi 5.5cqi 0;
    }
    #configurador .m-block[hidden] {
        display: none;
    }
    #configurador .m-block.is-new {
        animation: mNew 0.9s var(--ease-out-quart);
    }
    @keyframes mNew {
        from {
            opacity: 0;
            transform: translateY(3cqi);
        }
    }
    #configurador .m-h {
        display: block;
        margin-bottom: 2.6cqi;
        font-family: var(--m-tf);
        font-size: 5cqi;
        font-weight: var(--m-tw);
        letter-spacing: var(--m-tls);
        text-transform: var(--m-tt);
    }
    #configurador .m-gallery {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2cqi;
    }
    #configurador .m-tile {
        aspect-ratio: 1;
        border-radius: calc(3.6cqi * var(--m-r));
        background-size: cover;
        background-position: center;
    }
    #configurador .m-tile-1 { background-image: linear-gradient(135deg, color-mix(in srgb, var(--brand) 85%, #fff), var(--brand)); }
    #configurador .m-tile-2 { background-image: linear-gradient(200deg, color-mix(in srgb, var(--brand) 35%, #fff), color-mix(in srgb, var(--brand) 70%, #fff)); }
    #configurador .m-tile-3 { background-image: linear-gradient(30deg, color-mix(in srgb, var(--brand) 60%, #000), var(--brand)); }
    #configurador .m-tile-4 { background-image: linear-gradient(160deg, var(--m-card), color-mix(in srgb, var(--brand) 25%, var(--m-card))); }
    #configurador .m-reviews {
        display: grid;
        gap: 2.2cqi;
    }
    #configurador .m-review {
        margin: 0;
        padding: 3.6cqi 4cqi;
        border-radius: calc(3.6cqi * var(--m-r));
        background: var(--m-card);
        font-size: 3.6cqi;
        line-height: 1.4;
    }
    #configurador .m-review blockquote {
        margin: 1cqi 0;
    }
    #configurador .m-review figcaption {
        color: var(--m-muted);
        font-size: 3.2cqi;
    }
    #configurador .m-stars {
        color: #f5a623;
        letter-spacing: 0.1em;
        font-size: 3.4cqi;
    }
    #configurador .m-map {
        position: relative;
        height: 34cqi;
        border-radius: calc(3.6cqi * var(--m-r));
        background: color-mix(in srgb, var(--brand) 8%, var(--m-card));
        overflow: hidden;
    }
    #configurador .m-road {
        position: absolute;
        background: var(--m-bg);
        border-radius: 2cqi;
    }
    #configurador .m-road-1 { left: -10%; right: -10%; top: 55%; height: 3.4cqi; transform: rotate(-8deg); }
    #configurador .m-road-2 { top: -10%; bottom: -10%; left: 38%; width: 3cqi; transform: rotate(12deg); }
    #configurador .m-road-3 { left: 50%; right: -10%; top: 22%; height: 2.2cqi; transform: rotate(18deg); }
    #configurador .m-pin {
        position: absolute;
        left: 47%;
        top: 30%;
        width: 7cqi;
        height: 7cqi;
        border-radius: 50% 50% 50% 0;
        background: var(--brand);
        transform: rotate(-45deg);
        box-shadow: 0 1.5cqi 3cqi rgba(0, 0, 0, 0.25);
    }
    #configurador .m-pin::after {
        content: '';
        position: absolute;
        inset: 2.2cqi;
        border-radius: 50%;
        background: #fff;
    }
    #configurador .m-pin.is-bounce {
        animation: mBounce 0.7s var(--ease-out-quart);
    }
    @keyframes mBounce {
        40% { transform: rotate(-45deg) translate(3cqi, -3cqi); }
    }
    #configurador .m-btn2 {
        margin-top: 2.6cqi;
        padding: 2.4cqi 4.6cqi;
        border-radius: calc(99px * var(--m-r) + 1.2cqi);
        border: 1px solid color-mix(in srgb, var(--brand) 50%, var(--m-line));
        color: color-mix(in srgb, var(--brand) 80%, var(--m-fg));
        font-size: 3.5cqi;
        font-weight: 600;
    }
    #configurador .m-info {
        display: flex;
        flex-wrap: wrap;
        gap: 1.6cqi 4cqi;
        margin-top: auto;
        padding: 6cqi 5.5cqi 16cqi;
        font-size: 3.2cqi;
        color: var(--m-muted);
    }
    #configurador .m-info span::before {
        content: '';
        display: inline-block;
        width: 1.6cqi;
        height: 1.6cqi;
        margin-right: 1.4cqi;
        border-radius: 50%;
        background: var(--brand);
        vertical-align: middle;
    }

    /* WhatsApp */
    #configurador .m-wa {
        position: absolute;
        right: 4.5cqi;
        bottom: 5cqi;
        z-index: 3;
        display: grid;
        place-items: center;
        width: 13cqi;
        height: 13cqi;
        border-radius: 50%;
        background: #25d366;
        color: #fff;
        box-shadow: 0 2cqi 5cqi rgba(0, 0, 0, 0.25);
        transform: scale(0);
        transition: transform 0.4s var(--ease-out-quint);
    }
    #configurador .m-wa.is-on {
        transform: scale(1);
    }
    #configurador .m-wa svg {
        width: 7cqi;
        height: 7cqi;
        fill: currentColor;
    }

    /* Hoja inferior */
    #configurador .m-sheet {
        position: absolute;
        inset: 0;
        z-index: 5;
        display: flex;
        align-items: flex-end;
        background: rgba(0, 0, 0, 0);
        pointer-events: none;
        transition: background 0.3s ease;
    }
    #configurador .m-sheet.is-open {
        background: rgba(0, 0, 0, 0.38);
        pointer-events: auto;
    }
    #configurador .m-sheet-card {
        width: 100%;
        max-height: 80%;
        overflow-y: auto;
        padding: 3cqi 5.5cqi 7cqi;
        border-radius: 6cqi 6cqi 0 0;
        background: var(--m-bg);
        color: var(--m-fg);
        transform: translateY(105%);
        transition: transform 0.45s var(--ease-out-quint);
    }
    #configurador .m-sheet.is-open .m-sheet-card {
        transform: none;
    }
    #configurador .m-grab {
        display: block;
        width: 11cqi;
        height: 1.2cqi;
        margin: 0 auto 3cqi;
        border-radius: 1cqi;
        background: var(--m-line);
    }
    #configurador .m-sheet-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2cqi;
        margin-bottom: 2cqi;
    }
    #configurador .m-sheet-head b {
        font-family: var(--m-tf);
        font-size: 5cqi;
        font-weight: var(--m-tw);
        letter-spacing: -0.02em;
    }
    #configurador .m-x {
        display: grid;
        place-items: center;
        width: 8cqi;
        height: 8cqi;
        border-radius: 50%;
        background: var(--m-card);
        color: var(--m-muted);
        font-size: 5cqi;
        line-height: 1;
    }
    #configurador .m-sheet-l {
        margin: 3cqi 0 1.6cqi;
        font-size: 3.2cqi;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--m-muted);
    }
    #configurador .m-opts {
        display: flex;
        flex-wrap: wrap;
        gap: 2cqi;
    }
    #configurador .m-opt {
        padding: 2.4cqi 4.2cqi;
        border-radius: calc(99px * var(--m-r) + 1.5cqi);
        border: 1px solid var(--m-line);
        background: var(--m-card);
        color: var(--m-fg);
        font-size: 3.7cqi;
        font-weight: 500;
        transition:
            background 0.2s ease,
            color 0.2s ease,
            border-color 0.2s ease;
    }
    #configurador .m-opt[aria-pressed='true'] {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff;
    }
    #configurador .m-sheet-ok {
        width: 100%;
        margin-top: 5cqi;
        padding: 3.4cqi;
        border-radius: calc(99px * var(--m-r) + 2cqi);
        background: var(--brand);
        color: #fff;
        font-size: 4cqi;
        font-weight: 700;
    }
    #configurador .m-sheet-ok:active {
        transform: scale(0.98);
    }
    #configurador .m-done {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.6cqi;
        padding: 4cqi 0 2cqi;
        text-align: center;
        font-size: 3.7cqi;
        color: var(--m-muted);
    }
    #configurador .m-done b {
        font-family: var(--m-tf);
        font-size: 5.6cqi;
        color: var(--m-fg);
    }
    #configurador .m-done-ic {
        display: grid;
        place-items: center;
        width: 15cqi;
        height: 15cqi;
        border-radius: 50%;
        background: var(--brand);
        color: #fff;
        font-size: 7cqi;
        font-weight: 800;
        animation: mPop 0.5s var(--ease-out-quint);
    }
    @keyframes mPop {
        from { transform: scale(0.3); }
    }

    /* Chat de WhatsApp */
    #configurador .m-chat-head {
        display: flex;
        align-items: center;
        gap: 2.6cqi;
        padding-bottom: 3cqi;
        margin-bottom: 2cqi;
        border-bottom: 1px solid var(--m-line);
    }
    #configurador .m-chat-av {
        display: grid;
        place-items: center;
        width: 9cqi;
        height: 9cqi;
        border-radius: 50%;
        background: var(--brand);
        color: #fff;
        font-weight: 800;
        font-size: 4cqi;
    }
    #configurador .m-chat-head div {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
        font-size: 3.8cqi;
    }
    #configurador .m-chat-head small {
        color: #25a55a;
        font-size: 3cqi;
    }
    #configurador .m-msgs {
        display: flex;
        flex-direction: column;
        gap: 2cqi;
        min-height: 34cqi;
    }
    #configurador .m-msg {
        max-width: 82%;
        padding: 2.6cqi 3.4cqi;
        border-radius: 4cqi;
        font-size: 3.6cqi;
        line-height: 1.35;
        animation: mFade 0.3s var(--ease-out-quart);
    }
    #configurador .m-msg.yo {
        align-self: flex-end;
        background: #d9fdd3;
        color: #111;
        border-bottom-right-radius: 1cqi;
    }
    #configurador .m-msg.ellos {
        align-self: flex-start;
        background: var(--m-card);
        border-bottom-left-radius: 1cqi;
    }
    #configurador .m-typing {
        display: inline-flex;
        gap: 1cqi;
    }
    #configurador .m-typing i {
        width: 1.6cqi;
        height: 1.6cqi;
        border-radius: 50%;
        background: var(--m-muted);
        animation: mDot 1s infinite;
    }
    #configurador .m-typing i:nth-child(2) { animation-delay: 0.15s; }
    #configurador .m-typing i:nth-child(3) { animation-delay: 0.3s; }
    @keyframes mDot {
        50% { transform: translateY(-1cqi); opacity: 0.4; }
    }

    /* La misma web en ancho de ordenador: se reorganiza sola (como una web responsive real) */
    @container (min-width: 420px) {
        #configurador .m-status { display: none; }
        #configurador .m-nav { gap: 1.4cqi; padding: 2cqi 3.6cqi; }
        #configurador .m-logo { width: 4.6cqi; height: 4.6cqi; border-radius: calc(1.3cqi * var(--m-r)); font-size: 2.4cqi; }
        #configurador .m-name { flex: 0 1 auto; font-size: 2.5cqi; }
        #configurador .m-links { display: flex; gap: 2.6cqi; margin-left: auto; font-size: 1.7cqi; color: var(--m-muted); }
        #configurador .m-burger { display: none; }
        #configurador .m-hero { flex-direction: row-reverse; align-items: center; gap: 4cqi; padding: 4.6cqi 3.6cqi 3.4cqi; }
        #configurador .m-art { flex: 1; height: 25cqi; border-radius: calc(2.4cqi * var(--m-r)); }
        #configurador .m-art svg { width: 8cqi; height: 8cqi; }
        #configurador .m-copy { flex: 1.15; }
        #configurador .m-kicker { font-size: 1.5cqi; }
        #configurador .m-brand { margin: 0.6cqi -0.6cqi 0.8cqi; padding: 0 0.6cqi; font-size: 5.8cqi; }
        #configurador .m-caret { width: 0.35cqi; margin-left: 0.4cqi; }
        #configurador .m-title { margin: 0 0 1cqi; font-size: 2.6cqi; }
        #configurador .m-sub { font-size: 1.8cqi; max-width: 40ch; }
        #configurador .m-cta { margin-top: 2.2cqi; padding: 1.3cqi 2.8cqi; font-size: 1.8cqi; }
        #configurador .m-list { grid-template-columns: repeat(3, 1fr); gap: 1.6cqi; padding: 0 3.6cqi; }
        #configurador .m-item { flex-direction: column; align-items: flex-start; gap: 0.5cqi; padding: 2cqi 2.2cqi; border-radius: calc(1.6cqi * var(--m-r)); font-size: 1.8cqi; }
        #configurador .m-block { padding: 3.6cqi 3.6cqi 0; }
        #configurador .m-h { font-size: 2.6cqi; margin-bottom: 1.6cqi; }
        #configurador .m-gallery { grid-template-columns: repeat(4, 1fr); gap: 1.4cqi; }
        #configurador .m-tile { border-radius: calc(1.6cqi * var(--m-r)); }
        #configurador .m-reviews { grid-template-columns: 1fr 1fr; gap: 1.6cqi; }
        #configurador .m-review { padding: 2cqi 2.2cqi; font-size: 1.8cqi; border-radius: calc(1.6cqi * var(--m-r)); }
        #configurador .m-review figcaption, #configurador .m-stars { font-size: 1.6cqi; }
        #configurador .m-map { height: 16cqi; border-radius: calc(1.6cqi * var(--m-r)); }
        #configurador .m-pin { width: 3.4cqi; height: 3.4cqi; }
        #configurador .m-pin::after { inset: 1.1cqi; }
        #configurador .m-btn2 { margin-top: 1.4cqi; padding: 1.1cqi 2.2cqi; font-size: 1.6cqi; }
        #configurador .m-info { gap: 3cqi; padding: 3cqi 3.6cqi 4cqi; font-size: 1.5cqi; }
        #configurador .m-info span::before { width: 0.9cqi; height: 0.9cqi; margin-right: 0.8cqi; }
        #configurador .m-wa { width: 6cqi; height: 6cqi; right: 2.4cqi; bottom: 2.4cqi; }
        #configurador .m-wa svg { width: 3.4cqi; height: 3.4cqi; }
        /* En ordenador la hoja es una ventana centrada */
        #configurador .m-sheet { align-items: center; justify-content: center; }
        #configurador .m-sheet-card { width: 46%; max-height: 90%; padding: 2.4cqi 2.8cqi 3cqi; border-radius: calc(2.4cqi * var(--m-r) + 0.6cqi); transform: translateY(4cqi) scale(0.96); opacity: 0; transition: transform 0.4s var(--ease-out-quint), opacity 0.25s ease; }
        #configurador .m-sheet.is-open .m-sheet-card { opacity: 1; }
        #configurador .m-grab { display: none; }
        #configurador .m-sheet-head b { font-size: 2.4cqi; }
        #configurador .m-x { width: 3.6cqi; height: 3.6cqi; font-size: 2.4cqi; }
        #configurador .m-sheet-l { font-size: 1.4cqi; margin: 1.6cqi 0 0.8cqi; }
        #configurador .m-opts { gap: 1cqi; }
        #configurador .m-opt { padding: 1cqi 1.9cqi; font-size: 1.7cqi; }
        #configurador .m-sheet-ok { margin-top: 2.4cqi; padding: 1.5cqi; font-size: 1.8cqi; }
        #configurador .m-done { font-size: 1.8cqi; gap: 0.8cqi; padding: 1.6cqi 0 0.6cqi; }
        #configurador .m-done b { font-size: 2.6cqi; }
        #configurador .m-done-ic { width: 7cqi; height: 7cqi; font-size: 3.4cqi; }
        #configurador .m-chat-head { gap: 1.2cqi; padding-bottom: 1.4cqi; margin-bottom: 1cqi; }
        #configurador .m-chat-av { width: 4.2cqi; height: 4.2cqi; font-size: 1.9cqi; }
        #configurador .m-chat-head div { font-size: 1.8cqi; }
        #configurador .m-chat-head small { font-size: 1.4cqi; }
        #configurador .m-msgs { gap: 1cqi; min-height: 14cqi; }
        #configurador .m-msg { padding: 1.2cqi 1.6cqi; font-size: 1.7cqi; border-radius: 1.8cqi; }
        #configurador .m-typing i { width: 0.8cqi; height: 0.8cqi; }
    }

    /* ================= BOTÓN FINAL ================= */
    #configurador .cfg-cta-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.7rem;
        text-align: center;
    }
    @media (min-width: 1000px) {
        #configurador .cfg-cta-wrap {
            align-items: flex-start;
            text-align: left;
        }
    }
    #configurador .cfg-cta {
        min-height: 52px;
        padding: 0.9rem 1.8rem;
        font-size: 1.05rem;
        font-weight: 600;
        background: var(--brand);
        color: #fff;
    }
    @media (hover: hover) and (pointer: fine) {
        #configurador .cfg-cta:hover {
            background: color-mix(in srgb, var(--brand) 88%, #fff);
        }
    }
    #configurador .cfg-note {
        font-size: 0.88rem;
        color: var(--muted);
    }

    /* ================= ESCRITORIO (va al final para mandar sobre las reglas base) ================= */
    /* Escritorio: título a todo el ancho; panel de ajustes a la izquierda y la
       maqueta a la derecha, las dos columnas a la misma altura */
    @media (min-width: 1000px) {
        #configurador .cfg-grid {
            grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
            grid-template-areas:
                'head   head'
                'editor stage'
                'cta    stage';
            grid-template-rows: auto auto 1fr;
            column-gap: clamp(2.5rem, 4vw, 4rem);
            row-gap: 1.6rem;
            align-items: start;
        }
        /* Con la vista "Ordenador" la maqueta necesita sitio: gana ancho */
        #configurador.is-vista-pc .cfg-grid {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        }
        #configurador .cfg-head {
            margin-bottom: 0.6rem;
        }
        #configurador .cfg-sub {
            max-width: 62ch;
        }

        /* Panel de ajustes */
        #configurador .cfg-editor {
            container-type: inline-size;
            gap: 0;
            padding: 0.4rem 1.6rem 1.2rem;
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            background: color-mix(in srgb, var(--surface) 60%, transparent);
        }
        #configurador .cfg-step {
            padding: 1.3rem 0;
            border-bottom: 1px solid var(--border);
        }
        #configurador .cfg-dice {
            margin-top: 1rem;
        }
        #configurador .cfg-chip {
            min-height: 42px;
            padding: 0.45rem 0.85rem;
            font-size: 0.9rem;
            gap: 0.4rem;
        }
        #configurador .cfg-chip svg {
            width: 16px;
            height: 16px;
        }
        #configurador .cfg-chips-4 {
            display: flex;
            flex-wrap: wrap;
        }
        #configurador .cfg-sw {
            width: 34px;
            height: 34px;
        }
        #configurador .cfg-input,
        #configurador .cfg-photo {
            min-height: 44px;
        }
    }

    /* Si el panel es estrecho (p. ej. con la vista "Ordenador"): los grupos de 4 opciones
       en una cuadrícula 2×2 de botones iguales, en vez de quedarse uno suelto en otra línea */
    @container (max-width: 599.98px) {
        #configurador .cfg-chips-4 {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }
    }

    /* Si el panel es ancho: cada paso en una fila (etiqueta | opciones) */
    @container (min-width: 600px) {
        #configurador .cfg-step {
            display: grid;
            grid-template-columns: 138px minmax(0, 1fr);
            align-items: center;
            column-gap: 1.2rem;
            row-gap: 0.7rem;
        }
        /* float: el <legend> deja de ser la "leyenda" especial del fieldset y entra en la rejilla */
        #configurador .cfg-step > .cfg-legend {
            float: left;
            grid-column: 1;
            margin: 0;
        }
        #configurador .cfg-step > :not(.cfg-legend) {
            grid-column: 2;
        }
        #configurador .cfg-chips-4 {
            flex-wrap: nowrap;
        }
        #configurador .cfg-styles {
            margin-top: 0;
        }
        #configurador .cfg-hint {
            margin-top: -0.2rem;
        }
    }
</style>

<script>
    // @ts-nocheck
    const root = document.getElementById('configurador')

    if (root) {
        root.classList.add('cfg-js')

        const TIPOS = JSON.parse(root.dataset.tipos)
        const COLORES = JSON.parse(root.dataset.colores)
        const ESTILOS = JSON.parse(root.dataset.estilos)
        const EXTRAS = JSON.parse(root.dataset.extras)
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        const $ = (sel) => root.querySelector(sel)
        const $$ = (sel) => [...root.querySelectorAll(sel)]
        const m = (k) => root.querySelector(`[data-m="${k}"]`)
        const device = $('.cfg-device')
        const screen = $('.cfg-screen')
        const scroller = $('.m-scroll')
        const sheet = $('.m-sheet')
        const card = $('.m-sheet-card')
        const toast = $('.cfg-toast')
        const input = $('#cfg-nombre')
        const fotoInput = $('#cfg-foto')
        const live = $('#cfg-live')

        const state = {
            tipo: TIPOS[0],
            color: COLORES[0],
            estilo: ESTILOS[0],
            nombre: '',
            foto: null,
            extras: new Set(EXTRAS.filter((e) => e.on).map((e) => e.id)),
            device: 'phone',
        }
        const timers = new Set()
        const later = (fn, ms) => {
            const id = setTimeout(() => {
                timers.delete(id)
                fn()
            }, reduce ? Math.min(ms, 50) : ms)
            timers.add(id)
            return id
        }
        const clearTimers = () => {
            timers.forEach(clearTimeout)
            timers.clear()
        }

        const nombre = () => state.nombre || state.tipo.nombre
        const inicial = () => nombre().trim()[0]?.toUpperCase() || '·'
        const dominio = (n) =>
            n.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]/g, '') + '.es'
        const fill = (tpl, sel) => tpl.replace(/\{(\w+)\}/g, (_, k) => sel[k] ?? '')
        const pick = (arr) => arr[Math.floor(Math.random() * arr.length)]
        // Para frases: "galería", "opiniones"… pero "WhatsApp" con su mayúscula
        const etiqueta = (e) => (e.id === 'whatsapp' ? e.label : e.label.toLowerCase())

        const pulsar = (sel, attr, valor) =>
            $$(sel).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === valor)))

        const fade = (el) => {
            if (reduce || !el) return
            el.classList.remove('m-fade')
            void el.offsetWidth
            el.classList.add('m-fade')
        }

        /* ---------- El nombre se "escribe" solo la primera vez ----------
           Así se ve que es lo primero que se puede personalizar. */
        let tecleo = null
        const marcaWrap = () => m('marca').parentElement
        function pararTecleo() {
            if (tecleo) clearInterval(tecleo)
            tecleo = null
            marcaWrap().classList.remove('is-typing')
        }
        function teclear() {
            if (reduce || state.nombre) return
            const texto = nombre()
            let i = 0
            marcaWrap().classList.add('is-typing')
            m('marca').textContent = ''
            tecleo = setInterval(() => {
                i++
                m('marca').textContent = texto.slice(0, i)
                if (i >= texto.length) {
                    clearInterval(tecleo)
                    tecleo = null
                    setTimeout(() => marcaWrap().classList.remove('is-typing'), 1400)
                }
            }, 75)
        }
        new IntersectionObserver(
            (entries, obs) => {
                if (!entries[0].isIntersecting) return
                obs.disconnect()
                setTimeout(teclear, 350)
            },
            { threshold: 0.4 },
        ).observe(device)

        /* ---------- Pintar ---------- */
        function pintarNombre() {
            m('nombre').textContent = nombre()
            m('marca').textContent = nombre()
            m('inicial').textContent = inicial()
            m('url').textContent = dominio(nombre()) || 'tunegocio.es'
        }

        function pintarTipo() {
            pararTecleo()
            const t = state.tipo
            m('icono').innerHTML = t.icono
            m('kicker').textContent = t.kicker
            m('titulo').textContent = t.titulo
            m('sub').textContent = t.sub
            m('cta').textContent = t.cta
            m('tipcta').textContent = t.cta
            m('lista').innerHTML = t.lista.map(([a, b]) => `<span class="m-item"><b>${a}</b><span>${b}</span></span>`).join('')
            m('info').innerHTML = t.info.map((x) => `<span>${x}</span>`).join('')
            t.opiniones.forEach(([txt, autor], i) => {
                m(`op${i}`).textContent = txt
                m(`au${i}`).textContent = autor
            })
            input.placeholder = t.nombre
            pintarNombre()
            ;[m('art'), m('titulo'), m('sub'), m('lista')].forEach(fade)
        }

        function pintarEstilo() {
            ESTILOS.forEach((e) => screen.classList.toggle(`est-${e.id}`, e.id === state.estilo.id))
        }

        function pintarFoto() {
            const art = m('art')
            const tile = m('tile')
            const url = state.foto ? `url("${state.foto}")` : ''
            art.style.backgroundImage = url
            art.classList.toggle('has-foto', !!state.foto)
            tile.style.backgroundImage = url
            $('[data-foto-label]').textContent = state.foto ? 'Cambiar foto' : 'Añadir foto'
            $('[data-quitar-foto]').hidden = !state.foto
        }

        function pintarExtras(nuevo) {
            EXTRAS.forEach((e) => {
                const on = state.extras.has(e.id)
                if (e.id === 'whatsapp') {
                    $('.m-wa').classList.toggle('is-on', on)
                    m('tipwa').hidden = !on
                }
                else root.querySelector(`[data-block="${e.id}"]`).hidden = !on
                const b = root.querySelector(`[data-extra="${e.id}"]`)
                b.setAttribute('aria-pressed', String(on))
            })
            // Lleva la pantalla del móvil hasta el bloque recién añadido
            if (nuevo && nuevo !== 'whatsapp' && state.extras.has(nuevo)) {
                const blk = root.querySelector(`[data-block="${nuevo}"]`)
                blk.classList.remove('is-new')
                void blk.offsetWidth
                blk.classList.add('is-new')
                scroller.scrollTo({ top: blk.offsetTop - 60, behavior: reduce ? 'auto' : 'smooth' })
            }
        }

        function anunciar() {
            const ex = EXTRAS.filter((e) => state.extras.has(e.id)).map(etiqueta)
            live.textContent = `Vista previa: web de ${nombre()}, ${state.tipo.label.toLowerCase()}, color ${state.color.nombre}, estilo ${state.estilo.nombre}${ex.length ? ', con ' + ex.join(', ') : ''}.`
        }

        /* ---------- Notificación "que te llega a ti" ---------- */
        let toastTimer
        function avisar(texto) {
            toast.replaceChildren()
            const ic = document.createElement('span')
            ic.className = 'cfg-toast-ic'
            ic.textContent = inicial()
            const txt = document.createElement('span')
            txt.className = 'cfg-toast-txt'
            const small = document.createElement('small')
            small.textContent = 'Así te avisa tu web · ahora'
            const b = document.createElement('b')
            b.textContent = texto
            txt.append(small, b)
            toast.append(ic, txt)
            toast.classList.add('is-on')
            clearTimeout(toastTimer)
            toastTimer = setTimeout(() => toast.classList.remove('is-on'), 4200)
        }

        /* ---------- Hoja: reserva / compra ---------- */
        let sel = {}
        function abrirSheet(label) {
            card.setAttribute('aria-label', label)
            sheet.inert = false
            sheet.classList.add('is-open')
        }
        function cerrarSheet() {
            clearTimers()
            sheet.classList.remove('is-open')
            sheet.inert = true
        }

        function abrirFlujo() {
            const f = state.tipo.flujo
            sel = Object.fromEntries(f.grupos.map((g) => [g.k, g.v[0]]))
            card.innerHTML =
                `<span class="m-grab"></span>` +
                `<div class="m-sheet-head"><b>${f.titulo}</b><button type="button" class="m-x" data-accion="cerrar" aria-label="Cerrar">×</button></div>` +
                f.grupos
                    .map(
                        (g) =>
                            `<p class="m-sheet-l">${g.label}</p><div class="m-opts" data-k="${g.k}">` +
                            g.v.map((v, i) => `<button type="button" class="m-opt" data-v="${v}" aria-pressed="${i === 0}">${v}</button>`).join('') +
                            `</div>`,
                    )
                    .join('') +
                `<button type="button" class="m-sheet-ok" data-accion="confirmar">${f.boton}</button>`
            abrirSheet(f.titulo)
            card.querySelector('.m-opt')?.focus({ preventScroll: true })
        }

        function confirmar() {
            const f = state.tipo.flujo
            card.innerHTML =
                `<div class="m-done"><span class="m-done-ic">✓</span><b>${f.ok}</b><span>${fill(f.okSub, sel)}</span></div>`
            avisar(fill(f.aviso, sel))
            later(cerrarSheet, 2400)
        }

        /* ---------- Hoja: chat de WhatsApp ---------- */
        function abrirChat() {
            const [pregunta, respuesta] = state.tipo.chat
            card.innerHTML =
                `<span class="m-grab"></span>` +
                `<div class="m-chat-head"><span class="m-chat-av"></span><div><b class="m-chat-name"></b><small>en línea</small></div>` +
                `<button type="button" class="m-x" data-accion="cerrar" aria-label="Cerrar">×</button></div>` +
                `<div class="m-msgs"></div>`
            card.querySelector('.m-chat-av').textContent = inicial()
            card.querySelector('.m-chat-name').textContent = nombre()
            const msgs = card.querySelector('.m-msgs')
            const burbuja = (quien, contenido) => {
                const el = document.createElement('div')
                el.className = `m-msg ${quien}`
                if (typeof contenido === 'string') el.textContent = contenido
                else el.append(contenido)
                msgs.append(el)
                return el
            }
            abrirSheet(`Chat de WhatsApp con ${nombre()}`)
            later(() => {
                burbuja('yo', pregunta)
                avisar('WhatsApp · nuevo mensaje de un cliente')
            }, 450)
            later(() => {
                const dots = document.createElement('span')
                dots.className = 'm-typing'
                dots.innerHTML = '<i></i><i></i><i></i>'
                const esc = burbuja('ellos', dots)
                later(() => {
                    esc.textContent = respuesta
                }, 1200)
            }, 1200)
        }

        /* ---------- Eventos: editor ---------- */
        // Pestañas (móvil)
        $('.cfg-tabs').addEventListener('click', (e) => {
            const b = e.target.closest('[data-tab]')
            if (!b) return
            $$('.cfg-tabs [data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)))
            $$('.cfg-step').forEach((p) => p.classList.toggle('is-active', p.dataset.panel === b.dataset.tab))
        })

        // 1. Tipo
        root.querySelectorAll('[data-tipo]').forEach((b) =>
            b.addEventListener('click', () => {
                state.tipo = TIPOS.find((x) => x.id === b.dataset.tipo) || TIPOS[0]
                pulsar('[data-tipo]', 'data-tipo', state.tipo.id)
                cerrarSheet()
                pintarTipo()
                anunciar()
            }),
        )

        // 2. Nombre y foto
        input.addEventListener('input', () => {
            pararTecleo()
            state.nombre = input.value.trim().slice(0, 24)
            pintarNombre()
        })
        // Al escribir, el nombre se resalta en la web y la maqueta sube para verlo
        input.addEventListener('focus', () => {
            pararTecleo()
            pintarNombre()
            screen.classList.add('is-editing')
            scroller.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' })
        })
        input.addEventListener('blur', () => screen.classList.remove('is-editing'))
        input.addEventListener('change', anunciar)
        fotoInput.addEventListener('change', () => {
            const f = fotoInput.files?.[0]
            if (!f || !f.type.startsWith('image/')) return
            if (state.foto) URL.revokeObjectURL(state.foto)
            state.foto = URL.createObjectURL(f) // se queda en el navegador
            pintarFoto()
            scroller.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' })
        })
        $('[data-quitar-foto]').addEventListener('click', () => {
            if (state.foto) URL.revokeObjectURL(state.foto)
            state.foto = null
            fotoInput.value = ''
            pintarFoto()
        })

        // 3. Color y estilo
        root.querySelectorAll('[data-color]').forEach((b) =>
            b.addEventListener('click', () => {
                state.color = COLORES.find((x) => x.id === b.dataset.color) || COLORES[0]
                root.style.setProperty('--brand', state.color.hex)
                pulsar('[data-color]', 'data-color', state.color.id)
                anunciar()
            }),
        )
        root.querySelectorAll('[data-estilo]').forEach((b) =>
            b.addEventListener('click', () => {
                state.estilo = ESTILOS.find((x) => x.id === b.dataset.estilo) || ESTILOS[0]
                pulsar('[data-estilo]', 'data-estilo', state.estilo.id)
                pintarEstilo()
                fade(m('titulo'))
                anunciar()
            }),
        )

        // 4. Extras
        root.querySelectorAll('[data-extra]').forEach((b) =>
            b.addEventListener('click', () => {
                const id = b.dataset.extra
                state.extras.has(id) ? state.extras.delete(id) : state.extras.add(id)
                pintarExtras(id)
                anunciar()
            }),
        )

        // Sorpréndeme
        $('[data-dado]').addEventListener('click', (e) => {
            const btn = e.currentTarget
            btn.classList.remove('is-rolling')
            void btn.offsetWidth
            btn.classList.add('is-rolling')
            const otros = (arr, actual) => arr.filter((x) => x.id !== actual.id)
            state.tipo = pick(otros(TIPOS, state.tipo))
            state.color = pick(otros(COLORES, state.color))
            state.estilo = pick(ESTILOS)
            state.extras = new Set(EXTRAS.filter(() => Math.random() > 0.45).map((x) => x.id))
            if (!input.value) state.nombre = ''
            root.style.setProperty('--brand', state.color.hex)
            pulsar('[data-tipo]', 'data-tipo', state.tipo.id)
            pulsar('[data-color]', 'data-color', state.color.id)
            pulsar('[data-estilo]', 'data-estilo', state.estilo.id)
            cerrarSheet()
            pintarTipo()
            pintarEstilo()
            pintarExtras()
            scroller.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' })
            anunciar()
        })

        /* ---------- Eventos: dentro de la maqueta ---------- */
        screen.addEventListener('click', (e) => {
            const opt = e.target.closest('.m-opt')
            if (opt) {
                const grupo = opt.parentElement
                grupo.querySelectorAll('.m-opt').forEach((o) => o.setAttribute('aria-pressed', String(o === opt)))
                sel[grupo.dataset.k] = opt.dataset.v
                return
            }
            const acc = e.target.closest('[data-accion]')?.dataset.accion
            if (acc === 'flujo') abrirFlujo()
            else if (acc === 'chat') abrirChat()
            else if (acc === 'confirmar') confirmar()
            else if (acc === 'cerrar') cerrarSheet()
            else if (acc === 'mapa') {
                const pin = $('.m-pin')
                pin.classList.remove('is-bounce')
                void pin.offsetWidth
                pin.classList.add('is-bounce')
            } else if (e.target === sheet) cerrarSheet() // toque fuera de la hoja
        })
        screen.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && sheet.classList.contains('is-open')) cerrarSheet()
        })

        // Móvil / Ordenador
        $('.cfg-seg').addEventListener('click', (e) => {
            const b = e.target.closest('[data-device]')
            if (!b || b.dataset.device === state.device) return
            state.device = b.dataset.device
            pulsar('.cfg-seg [data-device]', 'data-device', state.device)
            cerrarSheet()
            const cambiar = () => {
                root.classList.toggle('is-vista-pc', state.device === 'desktop')
                device.classList.toggle('is-desktop', state.device === 'desktop')
                device.classList.toggle('is-phone', state.device === 'phone')
                scroller.scrollTop = 0 // cada formato empieza por arriba
            }
            if (reduce) cambiar()
            else {
                device.classList.add('is-swapping')
                setTimeout(() => {
                    cambiar()
                    setTimeout(() => device.classList.remove('is-swapping'), 380)
                }, 160)
            }
            anunciar()
        })

        // "Quiero una web así": el formulario de contacto recoge la elección
        $('#cfg-cta').addEventListener('click', () => {
            try {
                sessionStorage.setItem(
                    'ew-configurador',
                    JSON.stringify({
                        articulo: state.tipo.articulo,
                        nombre: nombre(),
                        color: state.color.nombre,
                        estilo: state.estilo.nombre,
                        extras: EXTRAS.filter((e) => state.extras.has(e.id)).map(etiqueta),
                    }),
                )
            } catch (e) {}
        })
    }
</script>
