---
// src/components/Footer.astro
import { SITE } from '@/lib/site.js'
const currentYear = new Date().getFullYear()
---

<footer class='site-footer'>
    <div class='container'>
        <div class='f-top'>
            <!-- Brand -->
            <div class='f-brand'>
                <a href='/' class='logo'>
                    <span class='logo-mark'>
                        <!-- Icono Rayo Premium -->
                        <svg
                            width='24'
                            height='24'
                            viewBox='0 0 24 24'
                            fill='none'
                            stroke='currentColor'
                            stroke-width='2'
                            stroke-linecap='round'
                            stroke-linejoin='round'
                            ><polygon
                                points='13 2 3 14 12 14 11 22 21 10 12 10 13 2'
                            ></polygon></svg
                        >
                    </span>
                    <span class='logo-text'>Extreweb</span>
                </a>
                <p>
                    Ingeniería digital premium desde Extremadura.<br />Diseñando
                    el futuro de internet, una línea de código a la vez.
                </p>

                <div class='f-socials'>
                    <a
                        href={SITE.instagram}
                        target='_blank'
                        rel='noopener'
                        aria-label='Instagram de extreweb'
                        ><svg
                            width='20'
                            height='20'
                            viewBox='0 0 24 24'
                            fill='none'
                            stroke='currentColor'
                            stroke-width='2'
                            aria-hidden='true'
                            ><rect x='2' y='2' width='20' height='20' rx='5' ry='5'
                            ></rect><path
                                d='M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z'
                            ></path><line x1='17.5' y1='6.5' x2='17.51' y2='6.5'
                            ></line></svg
                        ></a
                    >
                </div>
            </div>

            <!-- Links -->
            <div class='f-links'>
                <div class='f-col'>
                    <h2>Navegación</h2>
                    <ul>
                        <li><a href='/'>Inicio</a></li>
                        <li><a href='/servicios/'>Servicios</a></li>
                        <li><a href='/proyectos/'>Proyectos</a></li>
                        <li><a href='/proceso/'>Proceso</a></li>
                        <li><a href='/nosotros/'>Nosotros</a></li>
                    </ul>
                </div>
                <div class='f-col'>
                    <h2>Expertise</h2>
                    <ul>
                        <li><a href='/servicios/diseno-web/'>Diseño Web</a></li>
                        <li>
                            <a href='/servicios/seo/'>Posicionamiento SEO</a>
                        </li>
                        <li>
                            <a href='/servicios/redes-sociales/'
                                >Redes Sociales</a
                            >
                        </li>
                        <li>
                            <a href='/servicios/sistemas-soporte/'
                                >Sistemas y Soporte</a
                            >
                        </li>
                    </ul>
                </div>
                <div class='f-col'>
                    <h2>Contacto</h2>
                    <ul>
                        <li>
                            <a href='mailto:contactoextreweb@gmail.com'
                                >contactoextreweb@gmail.com</a
                            >
                        </li>
                        <li><a href='tel:+34628775619'>+34 628 775 619</a></li>
                        <li>
                            <a href='/contacto/' class='link-accent'
                                >Agendar llamada &rarr;</a
                            >
                        </li>
                    </ul>
                </div>
                <div class='f-col'>
                    <h2>Extremadura</h2>
                    <ul>
                        <li>
                            <a href='/diseno-web-villanueva-de-la-serena/'
                                >Villanueva de la Serena</a
                            >
                        </li>
                        <li><a href='/diseno-web-don-benito/'>Don Benito</a></li>
                        <li><a href='/diseno-web-caceres/'>Cáceres</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Big Typography Decoration -->
        <div class='f-big-text'>
            <span>EXTREWEB</span>
        </div>

        <!-- Bottom / Legal -->
        <div class='f-bottom'>
            <p>&copy; {currentYear} Extreweb. Todos los derechos reservados.</p>
            <div class='f-legal'>
                <a href='/aviso-legal/'>Aviso Legal</a>
                <a href='/privacidad/'>Privacidad</a>
                <a href='/cookies/'>Cookies</a>
            </div>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        background: var(--bg);
        padding-top: clamp(80px, 12vh, 140px);
        overflow: hidden;
        position: relative;
        border-top: 1px solid var(--border);
    }

    .f-top {
        display: flex;
        justify-content: space-between;
        gap: 4rem;
        flex-wrap: wrap;
        margin-bottom: clamp(4rem, 8vh, 6rem);
    }

    /* --- BRAND --- */
    .f-brand {
        flex: 1;
        min-width: 300px;
        max-width: 400px;
    }
    .logo {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--fg);
        text-decoration: none;
        font-weight: 700;
        font-size: 1.5rem;
        letter-spacing: -0.02em;
        margin-bottom: 1.5rem;
    }
    .logo-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: var(--fg);
        color: var(--bg);
        border-radius: 8px;
    }
    .f-brand p {
        color: var(--muted);
        line-height: 1.6;
        font-size: 1.05rem;
        margin-bottom: 2rem;
    }
    .f-socials {
        display: flex;
        gap: 1rem;
    }
    .f-socials a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid var(--border);
        color: var(--fg);
        transition: all 0.3s ease;
    }
    @media (hover: hover) {
        .f-socials a:hover {
            border-color: var(--accent);
            color: var(--accent);
            transform: translateY(-3px);
        }
    }

    /* --- LINKS --- */
    .f-links {
        display: flex;
        gap: clamp(3rem, 6vw, 6rem);
        flex-wrap: wrap;
    }
    .f-col {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    .f-col h2 {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--fg);
    }
    .f-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .f-col a {
        color: var(--muted);
        text-decoration: none;
        transition: color 0.3s ease;
        font-size: 1rem;
    }
    @media (hover: hover) {
        .f-col a:hover {
            color: var(--fg);
        }
    }
    .link-accent {
        color: var(--accent) !important;
        font-weight: 600;
    }

    /* --- BIG TEXT --- */
    .f-big-text {
        text-align: center;
        overflow: hidden;
        user-select: none;
        line-height: 0.8;
        padding-bottom: 2rem;
    }
    .f-big-text span {
        font-size: clamp(4rem, 15vw, 16rem);
        font-weight: 900;
        letter-spacing: -0.05em;
        background: linear-gradient(
            180deg,
            color-mix(in srgb, var(--fg) 30%, transparent) 0%,
            color-mix(in srgb, var(--fg) 2%, transparent) 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* --- BOTTOM --- */
    .f-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 2rem 0;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.9rem;
    }
    .f-legal {
        display: flex;
        gap: 1.5rem;
    }
    .f-legal a {
        color: var(--muted);
        text-decoration: none;
        transition: color 0.3s ease;
    }
    @media (hover: hover) {
        .f-legal a:hover {
            color: var(--fg);
        }
    }

    /* Mobile */
    @media (max-width: 768px) {
        .f-top {
            flex-direction: column;
            gap: 3rem;
        }
        .f-links {
            gap: 2.5rem;
            flex-direction: column;
        }
        .f-bottom {
            flex-direction: column;
            text-align: center;
            justify-content: center;
        }
    }
</style>
