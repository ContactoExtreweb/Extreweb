---
// src/components/Logo.astro — símbolo de la marca (Navbar y Footer). Squircle con el
// gradiente de la marca; dentro, la «E» de barras (extreweb, igual que public/favicon.svg)
// o «FG» (FG Digital, provisional). El tamaño lo pone quien lo usa (width/height por clase).
import { SITE } from '@/lib/site.js'
const { class: clase, ...resto } = Astro.props
---

<svg
    class:list={['marca', clase]}
    {...resto}
    viewBox='0 0 512 512'
    aria-hidden='true'
>
    {
        SITE.marca === 'fgdigital' ? (
            <text
                x='256'
                y='262'
                text-anchor='middle'
                dominant-baseline='middle'
                font-size='250'
                font-weight='800'
                letter-spacing='-12'
            >
                FG
            </text>
        ) : (
            <g>
                <rect x='150' y='140' width='50' height='232' rx='25' />
                <rect x='150' y='140' width='220' height='50' rx='25' />
                <rect x='150' y='231' width='158' height='50' rx='25' />
                <rect x='150' y='322' width='220' height='50' rx='25' />
            </g>
        )
    }
</svg>

<style>
    /* El gradiente va en CSS (no en <defs>): el logo sale dos veces por página y un id
       repetido en el SVG puede dejar uno sin pintar */
    .marca {
        flex-shrink: 0;
        border-radius: 23%; /* el rx 118/512 del favicon */
        background: linear-gradient(135deg, #0071e3, #7c5cff);
        fill: #ffffff;
        font-family: var(--font);
    }
</style>
