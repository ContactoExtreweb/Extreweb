---
// src/components/LocalLanding.astro
// Plantilla de las páginas por ciudad (/diseno-web-<ciudad>/). El DISEÑO es común,
// pero TODO el texto llega por props y tiene que ser distinto en cada ciudad:
// Google trata como "doorway pages" las páginas que solo cambian el nombre del sitio.
import BaseLayout from '@/layouts/BaseLayout.astro'
import Navbar from '@/components/Navbar.astro'
import Cta from '@/components/Cta.astro'
import Footer from '@/components/Footer.astro'
import { SITE } from '@/lib/site.js'

interface Proyecto {
    nombre: string
    sector: string
    lugar: string
    img: string
    url: string
    texto: string
}
interface Props {
    ciudad: string
    provincia: string
    slug: string // con barra final: '/diseno-web-caceres/'
    title: string
    description: string
    eyebrow: string
    intro: string
    proyectosTitulo: string
    proyectosIntro?: string
    proyectos: Proyecto[]
    contextoTitulo: string
    contexto: string[]
    cercaniaTitulo: string
    cercania: string
    faqs: { q: string; a: string }[]
}

const p = Astro.props
const url = SITE.url + p.slug

const servicios = [
    { href: '/servicios/diseno-web/', nombre: 'Diseño y desarrollo web', txt: 'Webs corporativas, tiendas online y aplicaciones a medida.' },
    { href: '/servicios/seo/', nombre: 'Posicionamiento SEO local', txt: `Para que te encuentren en Google cuando buscan en ${p.ciudad}.` },
    { href: '/servicios/redes-sociales/', nombre: 'Redes sociales', txt: 'Contenido y campañas para tu público de la zona.' },
    { href: '/servicios/sistemas-soporte/', nombre: 'Sistemas y soporte técnico', txt: 'Ordenadores, redes y mantenimiento para que tu negocio no pare.' },
]

const ciudades = [
    { href: '/diseno-web-villanueva-de-la-serena/', nombre: 'Villanueva de la Serena' },
    { href: '/diseno-web-don-benito/', nombre: 'Don Benito' },
    { href: '/diseno-web-caceres/', nombre: 'Cáceres' },
].filter((c) => c.href !== p.slug)

// Datos estructurados: servicio local + migas de pan
const schema = [
    {
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: `Diseño web en ${p.ciudad}`,
        serviceType: 'Diseño y desarrollo web',
        description: p.description,
        url,
        provider: { '@id': SITE.url + '/#business' },
        areaServed: {
            '@type': 'City',
            name: p.ciudad,
            containedInPlace: { '@type': 'AdministrativeArea', name: `Provincia de ${p.provincia}` },
        },
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
            { '@type': 'ListItem', position: 2, name: `Diseño web en ${p.ciudad}`, item: url },
        ],
    },
]
---

<BaseLayout title={p.title} description={p.description}>
    <script type='application/ld+json' set:html={JSON.stringify(schema)} />
    <Navbar />

    <main class='page-main'>
        <div class='ambient-glow' aria-hidden='true'></div>

        <!-- HERO -->
        <section class='ll-hero'>
            <div class='container'>
                <nav class='ll-crumbs' aria-label='Migas de pan'>
                    <a href='/'>Inicio</a>
                    <span aria-hidden='true'>›</span>
                    <span aria-current='page'>Diseño web en {p.ciudad}</span>
                </nav>
                <span class='eyebrow fx-in-soft'>{p.eyebrow}</span>
                <h1 class='fx-in'>
                    Diseño web en<br /><span class='text-accent'>{p.ciudad}.</span>
                </h1>
                <p class='ll-intro fx-in-soft'>{p.intro}</p>
                <div class='ll-actions fx-in-soft'>
                    <a href='/contacto/' class='btn btn-accent'>Pedir presupuesto</a>
                    <a
                        href='https://wa.me/34628775619'
                        class='ll-link'
                        target='_blank'
                        rel='noopener'>Escríbenos por WhatsApp&nbsp;›</a
                    >
                </div>
            </div>
        </section>

        <!-- PROYECTOS REALES -->
        <section class='ll-section'>
            <div class='container'>
                <h2 class='ll-h2'>{p.proyectosTitulo}</h2>
                {p.proyectosIntro && <p class='ll-lead'>{p.proyectosIntro}</p>}
                <div class:list={['ll-cases', { 'is-single': p.proyectos.length === 1 }]}>
                    {
                        p.proyectos.map((pr) => (
                            <a
                                class='ll-case'
                                href={pr.url}
                                target='_blank'
                                rel='noopener'
                            >
                                <div class='ll-case-img'>
                                    <img
                                        src={pr.img}
                                        alt={`Web de ${pr.nombre}`}
                                        width='1905'
                                        height='953'
                                        loading='lazy'
                                        decoding='async'
                                    />
                                </div>
                                <div class='ll-case-body'>
                                    <span class='ll-case-meta'>
                                        {pr.sector} · {pr.lugar}
                                    </span>
                                    <h3>
                                        {pr.nombre}{' '}
                                        <span class='ll-ext' aria-hidden='true'>↗</span>
                                    </h3>
                                    <p>{pr.texto}</p>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- CONTEXTO LOCAL -->
        <section class='ll-section'>
            <div class='container ll-narrow'>
                <h2 class='ll-h2'>{p.contextoTitulo}</h2>
                {p.contexto.map((t) => <p class='ll-text'>{t}</p>)}
            </div>
        </section>

        <!-- SERVICIOS (enlazado interno) -->
        <section class='ll-section'>
            <div class='container ll-narrow'>
                <h2 class='ll-h2'>Qué hacemos para negocios de {p.ciudad}</h2>
                <ul class='ll-services'>
                    {
                        servicios.map((s) => (
                            <li>
                                <a href={s.href}>
                                    <span>
                                        <strong>{s.nombre}</strong>
                                        <small>{s.txt}</small>
                                    </span>
                                    <span class='ll-arrow' aria-hidden='true'>→</span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <!-- CERCANÍA -->
        <section class='ll-section'>
            <div class='container'>
                <div class='ll-band'>
                    <h2 class='ll-h2'>{p.cercaniaTitulo}</h2>
                    <p>{p.cercania}</p>
                    <a href='tel:+34628775619' class='btn'>Llamar al 628 77 56 19</a>
                </div>
            </div>
        </section>

        <!-- PREGUNTAS FRECUENTES (sin JS: <details>) -->
        <section class='ll-section'>
            <div class='container ll-narrow'>
                <h2 class='ll-h2'>Preguntas de negocios de {p.ciudad}</h2>
                <div class='ll-faqs'>
                    {
                        p.faqs.map((f) => (
                            <details class='ll-faq'>
                                <summary>
                                    {f.q}
                                    <span class='ll-plus' aria-hidden='true' />
                                </summary>
                                <p>{f.a}</p>
                            </details>
                        ))
                    }
                </div>

                <p class='ll-others'>
                    También trabajamos en{' '}
                    {/* En una línea: los saltos meterían un espacio antes de la coma */}
                    {ciudades.map((c, i) => (<><a href={c.href}>{c.nombre}</a>{i < ciudades.length - 1 ? ', ' : ''}</>))}{' '}
                    y en toda Extremadura.
                </p>
            </div>
        </section>

        <Cta />
    </main>
    <Footer />
</BaseLayout>

<style>
    .page-main {
        background: var(--bg);
        overflow-x: hidden;
        position: relative;
    }
    .ambient-glow {
        position: absolute;
        width: 600px;
        height: 600px;
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
        border-radius: 50%;
        background: var(--accent);
        /* Degradado en vez de filter: blur(120px): mismo halo, pero sin
           recalcular un desenfoque enorme cada vez que se repinta la zona */
        -webkit-mask-image: radial-gradient(closest-side, #000 20%, transparent);
        mask-image: radial-gradient(closest-side, #000 20%, transparent);
        scale: 1.7;
        opacity: 0.15;
        pointer-events: none;
    }
    html[data-theme='light'] .ambient-glow {
        opacity: 0.08;
    }

    /* --- HERO --- */
    .ll-hero {
        position: relative;
        text-align: center;
        padding: clamp(130px, 18vh, 200px) 0 clamp(3rem, 8vh, 5rem);
    }
    .ll-crumbs {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--muted);
        margin-bottom: 1.5rem;
    }
    .ll-crumbs a {
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    .eyebrow {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1.25rem;
    }
    .ll-hero h1 {
        font-size: clamp(2.6rem, 7vw, 5.5rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.04em;
        margin-bottom: 1.5rem;
    }
    .ll-intro {
        font-size: clamp(1.1rem, 2vw, 1.35rem);
        line-height: 1.6;
        color: var(--muted);
        max-width: 640px;
        margin: 0 auto;
    }
    .ll-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 1rem 1.5rem;
        margin-top: 2rem;
    }
    .ll-actions .btn {
        min-height: 48px;
    }
    .ll-link {
        color: var(--accent);
        font-weight: 500;
        padding: 0.75rem 0.25rem;
    }

    /* --- SECCIONES --- */
    .ll-section {
        position: relative;
        padding-block: clamp(2.5rem, 7vh, 5rem);
    }
    .ll-narrow {
        max-width: 760px;
    }
    .ll-h2 {
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }
    .ll-lead,
    .ll-text {
        font-size: 1.1rem;
        line-height: 1.7;
        color: var(--muted);
    }
    .ll-lead {
        margin-bottom: 2rem;
    }
    .ll-text + .ll-text {
        margin-top: 1.1rem;
    }

    /* --- PROYECTOS --- */
    .ll-cases {
        display: grid;
        gap: 1.5rem;
    }
    .ll-case {
        display: flex;
        flex-direction: column;
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        background: var(--surface);
        overflow: hidden;
        transition: transform var(--dur-fast) var(--ease-out-quart),
            border-color var(--dur-mid) var(--ease-out-quart);
    }
    .ll-case:active {
        transform: scale(0.99);
    }
    .ll-case-img {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-bottom: 1px solid var(--border);
    }
    .ll-case-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        transition: transform var(--dur-slow) var(--ease-out-quart);
    }
    .ll-case-body {
        padding: 1.4rem 1.4rem 1.6rem;
    }
    .ll-case-meta {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
    }
    .ll-case h3 {
        font-size: 1.45rem;
        letter-spacing: -0.02em;
        margin: 0.35rem 0 0.6rem;
    }
    .ll-ext {
        color: var(--accent);
    }
    .ll-case p {
        color: var(--muted);
        line-height: 1.6;
    }
    @media (min-width: 760px) {
        .ll-cases {
            grid-template-columns: 1fr 1fr;
        }
        .ll-cases.is-single {
            grid-template-columns: 1fr;
        }
        .ll-cases.is-single .ll-case {
            flex-direction: row;
        }
        .ll-cases.is-single .ll-case-img {
            flex: 1.3;
            aspect-ratio: auto;
            border-bottom: none;
            border-right: 1px solid var(--border);
        }
        .ll-cases.is-single .ll-case-body {
            flex: 1;
            align-self: center;
            padding: 2rem;
        }
    }
    @media (hover: hover) and (pointer: fine) {
        .ll-case:hover {
            border-color: var(--accent);
        }
        .ll-case:hover .ll-case-img img {
            transform: scale(1.03);
        }
    }

    /* --- SERVICIOS --- */
    .ll-services {
        border-top: 1px solid var(--border);
    }
    .ll-services a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 0.25rem;
        border-bottom: 1px solid var(--border);
        min-height: 56px;
    }
    .ll-services strong {
        display: block;
        font-size: 1.1rem;
        font-weight: 600;
    }
    .ll-services small {
        display: block;
        font-size: 0.95rem;
        color: var(--muted);
        margin-top: 0.15rem;
    }
    .ll-arrow {
        color: var(--accent);
        font-size: 1.2rem;
        transition: transform var(--dur-mid) var(--ease-out-quart);
    }
    @media (hover: hover) and (pointer: fine) {
        .ll-services a:hover .ll-arrow {
            transform: translateX(4px);
        }
    }

    /* --- CERCANÍA --- */
    .ll-band {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: clamp(1.75rem, 5vw, 3.5rem);
        max-width: 900px;
        margin-inline: auto;
    }
    .ll-band p {
        font-size: 1.1rem;
        line-height: 1.7;
        color: var(--muted);
        margin-bottom: 1.5rem;
    }
    .ll-band .btn {
        background: var(--bg);
        border: 1px solid var(--border);
        min-height: 48px;
    }

    /* --- FAQ --- */
    .ll-faqs {
        border-top: 1px solid var(--border);
    }
    .ll-faq {
        border-bottom: 1px solid var(--border);
    }
    .ll-faq summary {
        list-style: none;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1.15rem 0.25rem;
        font-size: 1.1rem;
        font-weight: 600;
        min-height: 56px;
    }
    .ll-faq summary::-webkit-details-marker {
        display: none;
    }
    .ll-plus {
        position: relative;
        flex-shrink: 0;
        width: 14px;
        height: 14px;
    }
    .ll-plus::before,
    .ll-plus::after {
        content: '';
        position: absolute;
        left: 0;
        top: 6px;
        width: 14px;
        height: 2px;
        border-radius: 2px;
        background: var(--accent);
        transition: transform var(--dur-mid) var(--ease-out-quart);
    }
    .ll-plus::after {
        transform: rotate(90deg);
    }
    .ll-faq[open] .ll-plus::after {
        transform: rotate(0deg);
    }
    .ll-faq p {
        padding: 0 0.25rem 1.3rem;
        color: var(--muted);
        line-height: 1.7;
    }
    .ll-others {
        margin-top: 2.5rem;
        color: var(--muted);
    }
    .ll-others a {
        color: var(--accent);
        font-weight: 500;
    }
</style>
