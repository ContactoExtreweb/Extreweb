---
// src/components/Showcase.astro — "Anatomía de una web que vende"
// La web real de GuadiCar se abre en tres capas al hacer scroll y se vuelve a
// montar al final: 1) lo que ve el cliente, 2) lo que lee Google, 3) la velocidad.
//
// Sin JS o con "reducir movimiento": texto como lista normal, sin scroll largo
// y con la captura plana (la clase html.js-motion la pone BaseLayout).
// Los datos de la capa de Google son los REALES de guadicar.es (título,
// descripción y tipo de schema). No inventar métricas ni reseñas aquí.

const pasos = [
    {
        eyebrow: 'Por dentro',
        titulo: 'Una web que vende tiene tres capas.',
        texto: 'Esta es la web que hicimos para GuadiCar, un concesionario de Villanueva de la Serena. Desliza y te la abrimos por dentro.',
    },
    {
        eyebrow: 'Capa 1 · Lo que ve tu cliente',
        titulo: 'Un diseño que lleva a la acción.',
        texto: 'Cada foto, botón y texto está donde tiene que estar para que el cliente llame, pida cita o compre. Y se diseña primero para el móvil, que es desde donde te van a mirar.',
    },
    {
        eyebrow: 'Capa 2 · Lo que lee Google',
        titulo: 'Una estructura que Google entiende.',
        texto: 'Título, descripción y los datos del negocio (qué es, dónde está, a qué hora abre) en el formato que lee Google. Así sabe qué vendes y te enseña cuando alguien lo busca.',
    },
    {
        eyebrow: 'Capa 3 · Lo que no se ve',
        titulo: 'Rápida, también con poca cobertura.',
        texto: 'Código ligero, imágenes optimizadas y servidores repartidos por el mundo. La web carga al momento y no se cae cuando más visitas tienes.',
    },
    {
        eyebrow: 'Todo junto',
        titulo: 'Tres capas, una web que trabaja por ti.',
        texto: 'Por fuera, una web bonita. Por dentro, una herramienta que te trae clientes cada día.',
    },
]

const barras = [
    { label: 'Página', x: 0, w: 0.26 },
    { label: 'Estilos', x: 0.1, w: 0.16 },
    { label: 'Fuentes', x: 0.16, w: 0.14 },
    { label: 'Imágenes', x: 0.22, w: 0.32 },
    { label: 'Mapa y extras', x: 0.46, w: 0.18 },
]
---

<section class='anatomy' id='anatomia' aria-labelledby='anatomia-title'>
    <div class='an-sticky'>
        <div class='container an-grid'>
            <!-- ===== TEXTO ===== -->
            <div class='an-copy'>
                <ol class='an-rail' aria-hidden='true'>
                    {pasos.map((_, i) => <li class:list={{ 'is-on': i === 0 }} />)}
                </ol>

                <div class='an-steps'>
                    {
                        pasos.map((p, i) => (
                            <article class:list={['an-step', `an-step-${i}`, { 'is-active': i === 0 }]} data-step={i}>
                                <p class='an-eyebrow'>{p.eyebrow}</p>
                                {i === 0 ? <h2 id='anatomia-title'>{p.titulo}</h2> : <h3>{p.titulo}</h3>}
                                <p class='an-text'>{p.texto}</p>
                                {i === pasos.length - 1 && (
                                    <a class='an-link' href='https://guadicar.es' target='_blank' rel='noopener'>
                                        Ver la web de GuadiCar <span aria-hidden='true'>↗</span>
                                    </a>
                                )}
                            </article>
                        ))
                    }
                </div>
            </div>

            <!-- ===== CAPAS 3D (decorativo: el significado está en el texto) ===== -->
            <div class='an-stage' aria-hidden='true'>
                <div class='an-glow'></div>
                <div class='an-scene' data-activo='0' style='--t: 0; --s: 0;'>
                    <!-- Capa 3 (abajo): velocidad -->
                    <div class='an-layer an-l3'>
                        <span class='an-tag'><b>3</b> Velocidad</span>
                        <div class='an-speed'>
                            <div class='an-speed-head'>
                                <span>Carga de la página</span>
                                <span class='an-ok'>✓ Lista</span>
                            </div>
                            <ul class='an-bars'>
                                {
                                    barras.map((b, i) => (
                                        <li>
                                            <span>{b.label}</span>
                                            <i style={`--x:${b.x};--w:${b.w};--d:${i * 90}ms`} />
                                        </li>
                                    ))
                                }
                            </ul>
                            <div class='an-axis'><span></span><span></span><span></span><span></span></div>
                        </div>
                    </div>

                    <!-- Capa 2 (medio): lo que lee Google — datos reales de guadicar.es -->
                    <div class='an-layer an-l2'>
                        <span class='an-tag'><b>2</b> Google</span>
                        <div class='an-serp'>
                            <div class='an-search'>
                                <svg viewBox='0 0 24 24'><circle cx='11' cy='11' r='7'></circle><path d='m20 20-3.5-3.5'></path></svg>
                                <span>concesionario coches villanueva de la serena</span>
                            </div>
                            <div class='an-result'>
                                <span class='an-site'><i>G</i><span>guadicar.es</span></span>
                                <b>GuadiCar Multimarcas — Coches de Ocasión y Km0 en Villanueva de la Serena (Badajoz)</b>
                                <p>Concesionario multimarca en Villanueva de la Serena (Badajoz). Vehículos de ocasión, Km0 y nuevos con garantía y financiación.</p>
                            </div>
                            <pre class='an-code'><span class='k'>"@type"</span>: <span class='v'>"AutoDealer"</span>,
<span class='k'>"address"</span>: {'{'} <span class='k'>"addressLocality"</span>: <span class='v'>"Villanueva de la Serena"</span> {'}'},
<span class='k'>"geo"</span>: {'{'} … {'}'},  <span class='k'>"openingHoursSpecification"</span>: [ … ]</pre>
                        </div>
                    </div>

                    <!-- Capa 1 (arriba): la web terminada -->
                    <div class='an-layer an-l1'>
                        <span class='an-tag'><b>1</b> Diseño</span>
                        <img
                            src='/proyectos/Guadicar.webp'
                            srcset='/proyectos/Guadicar-800.webp 800w, /proyectos/Guadicar-1200.webp 1200w, /proyectos/Guadicar.webp 1904w'
                            sizes='(max-width: 860px) 92vw, 760px'
                            alt=''
                            width='1904'
                            height='951'
                            loading='lazy'
                            decoding='async'
                        />
                        <span class='an-live'><i></i>En producción · guadicar.es</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Cuánto se apartan las capas de ENCIMA de la activa (para que no la tapen).
       Registradas con @property para que se animen solas con una transición,
       sin retrasar el movimiento que va pegado al scroll. */
    @property --an-up1 {
        syntax: '<length>';
        inherits: true;
        initial-value: 0px;
    }
    @property --an-up2 {
        syntax: '<length>';
        inherits: true;
        initial-value: 0px;
    }

    /* ================= ESTRUCTURA DEL SCROLL ================= */
    .anatomy {
        --c1: var(--accent); /* diseño */
        --c2: #30b35b; /* google */
        --c3: #7c5cff; /* velocidad */
        position: relative;
        background: var(--bg);
        height: 420vh;
    }
    .an-sticky {
        position: sticky;
        top: 0;
        height: 100vh;
        height: 100svh;
        display: flex;
        align-items: center;
        overflow: clip;
    }
    .an-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        align-items: center;
        gap: clamp(2rem, 5vw, 5rem);
        width: 100%;
    }

    /* ================= TEXTO ================= */
    .an-copy {
        display: flex;
        gap: 1.6rem;
        align-items: center;
    }
    .an-rail {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        flex-shrink: 0;
    }
    .an-rail li {
        width: 6px;
        height: 6px;
        border-radius: 99px;
        background: var(--border);
        transition:
            height var(--dur-slow) var(--ease-out-quart),
            background var(--dur-slow) var(--ease-out-quart);
    }
    .an-rail li.is-on {
        height: 26px;
        background: var(--accent);
    }
    .an-steps {
        position: relative;
        flex: 1;
        min-height: 340px;
    }
    .an-step {
        position: absolute;
        inset: 50% 0 auto 0;
        transform: translateY(calc(-50% + 36px));
        opacity: 0;
        visibility: hidden;
        filter: blur(6px);
        transition:
            opacity 0.6s var(--ease-out-quart),
            transform 0.7s var(--ease-out-expo),
            filter 0.6s var(--ease-out-quart),
            visibility 0s linear 0.7s;
    }
    .an-step.is-active {
        opacity: 1;
        visibility: visible;
        filter: none;
        transform: translateY(-50%);
        transition-delay: 0.08s, 0.08s, 0.08s, 0s;
    }
    .an-step.is-past {
        transform: translateY(calc(-50% - 36px));
    }
    .an-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.9rem;
    }
    .an-step-2 .an-eyebrow { color: var(--c2); }
    .an-step-3 .an-eyebrow { color: var(--c3); }
    .an-step h2,
    .an-step h3 {
        font-size: clamp(2rem, 4vw, 3.3rem);
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1.05;
        margin-bottom: 1rem;
    }
    .an-text {
        font-size: clamp(1.02rem, 1.4vw, 1.18rem);
        line-height: 1.6;
        color: var(--muted);
        max-width: 44ch;
    }
    .an-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 1.4rem;
        min-height: 44px;
        font-weight: 600;
        color: var(--accent);
    }
    @media (hover: hover) and (pointer: fine) {
        .an-link:hover {
            text-decoration: underline;
            text-underline-offset: 3px;
        }
    }

    /* ================= ESCENA 3D ================= */
    .an-stage {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        perspective: 1400px;
    }
    .an-glow {
        position: absolute;
        inset: -10% -5%;
        border-radius: 50%;
        /* Sin filter: blur (costaba repintar). closest-side: el degradado llega a
           transparente justo en el borde, así no se ve el contorno del círculo */
        background: radial-gradient(
            closest-side,
            color-mix(in srgb, var(--accent) 22%, transparent),
            transparent
        );
        opacity: 0.35; /* el script lo sube al separarse las capas */
        will-change: opacity;
        pointer-events: none;
    }
    .an-scene {
        --gap: 150px;
        position: relative;
        width: min(100%, 760px);
        aspect-ratio: 1904 / 951;
        transform-style: preserve-3d;
        transform: rotateX(calc(var(--t) * 54deg))
            rotateZ(calc(var(--t) * -24deg))
            scale(calc(1 - var(--t) * 0.1));
        will-change: transform;
        transition:
            --an-up1 0.7s var(--ease-out-quart),
            --an-up2 0.7s var(--ease-out-quart);
    }
    .an-scene[data-activo='2'] {
        --an-up1: 110px;
    }
    .an-scene[data-activo='3'] {
        --an-up1: 190px;
        --an-up2: 110px;
    }
    .an-layer {
        position: absolute;
        inset: 0;
        border-radius: 16px;
        backface-visibility: hidden;
        /* Se mueven en cada frame del scroll: con will-change el navegador las
           pinta una vez y luego solo las recoloca (sin esto las volvía a pintar
           a cada cambio de profundidad, que en móvil se notaba) */
        will-change: transform;
        transition: opacity 0.5s var(--ease-out-quart);
    }
    /* Brillo de la capa activa: la sombra ya está pintada en un ::after y solo
       cambia su opacidad. Animar box-shadow repintaba la capa (imagen incluida) */
    .an-layer::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        box-shadow:
            0 0 0 2px var(--c),
            0 30px 90px -20px color-mix(in srgb, var(--c) 70%, transparent);
        opacity: 0;
        transition: opacity 0.5s var(--ease-out-quart);
        pointer-events: none;
    }
    .an-l1 {
        --c: var(--c1);
        transform: translateZ(calc(var(--s) * (var(--gap) + var(--an-up1))));
        background: var(--surface);
        box-shadow: 0 0 0 1px var(--border), 0 30px 60px -30px rgba(0, 0, 0, 0.35);
    }
    .an-l1 img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        border-radius: inherit; /* recorta la imagen (sin overflow en la capa, que cortaría el brillo) */
    }
    .an-l2 {
        --c: var(--c2);
        transform: translateZ(calc(var(--s) * var(--an-up2)));
        background: #fff;
        box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
    }
    .an-l3 {
        --c: var(--c3);
        transform: translateZ(calc(var(--s) * var(--gap) * -1));
        background: #0c0c10;
        box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08);
    }

    /* Etiqueta de cada capa: solo aparece al separarse */
    .an-tag {
        position: absolute;
        top: -14px;
        left: 18px;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.3rem 0.8rem 0.3rem 0.35rem;
        border-radius: 99px;
        font-size: 0.8rem;
        font-weight: 600;
        color: #fff;
        background: var(--c1);
        opacity: 0;
        transition: opacity 0.4s var(--ease-out-quart);
        box-shadow: 0 6px 20px -6px rgba(0, 0, 0, 0.4);
    }
    /* .is-abierta la pone el script cuando las capas se separan */
    .an-scene.is-abierta .an-tag {
        opacity: 1;
    }
    .an-tag b {
        display: grid;
        place-items: center;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        font-size: 0.72rem;
        background: rgba(255, 255, 255, 0.25);
    }
    .an-l2 .an-tag { background: var(--c2); }
    .an-l3 .an-tag { background: var(--c3); }
    .an-l1 .an-tag {
        top: 14px; /* dentro, sobre la captura */
    }

    /* Capa activa: se ilumina; las demás se apagan */
    .an-scene[data-activo='1'] .an-layer:not(.an-l1),
    .an-scene[data-activo='2'] .an-layer:not(.an-l2),
    .an-scene[data-activo='3'] .an-layer:not(.an-l3) {
        opacity: 0.16;
    }
    .an-scene[data-activo='1'] .an-l1::after,
    .an-scene[data-activo='2'] .an-l2::after,
    .an-scene[data-activo='3'] .an-l3::after {
        opacity: 1;
    }

    /* "En producción": solo al final, con la web ya montada */
    .an-live {
        position: absolute;
        left: 14px; /* a la derecha taparía el botón de chat de la web de GuadiCar */
        bottom: 14px;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.4rem 0.8rem;
        border-radius: 99px;
        font-size: 0.78rem;
        font-weight: 600;
        color: #fff;
        background: rgba(0, 0, 0, 0.78);
        opacity: 0;
        transform: translateY(8px);
        transition:
            opacity 0.5s var(--ease-out-quart),
            transform 0.6s var(--ease-out-expo);
    }
    .an-live i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #34c759;
        box-shadow: 0 0 0 3px rgba(52, 199, 89, 0.3);
    }
    .an-scene[data-paso='4'] .an-live {
        opacity: 1;
        transform: none;
    }

    /* --- Capa 2: Google --- */
    .an-serp {
        position: absolute;
        inset: 0;
        padding: 5% 6%;
        display: flex;
        flex-direction: column;
        gap: 4%;
        color: #202124;
        font-family: Arial, Helvetica, sans-serif;
        overflow: hidden;
        border-radius: inherit;
    }
    .an-search {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.55rem 0.9rem;
        border-radius: 99px;
        border: 1px solid #dfe1e5;
        font-size: clamp(0.62rem, 1.2vw, 0.85rem);
        box-shadow: 0 1px 6px rgba(32, 33, 36, 0.12);
    }
    .an-search svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        fill: none;
        stroke: #5f6368;
        stroke-width: 2;
    }
    .an-result {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        font-size: clamp(0.58rem, 1.1vw, 0.82rem);
        line-height: 1.4;
    }
    .an-site {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: #202124;
    }
    .an-site i {
        display: grid;
        place-items: center;
        width: 1.7em;
        height: 1.7em;
        border-radius: 50%;
        background: #f1f3f4;
        font-style: normal;
        font-weight: 700;
        color: #c62828;
    }
    .an-result b {
        font-weight: 400;
        font-size: 1.28em;
        color: #1a0dab;
        line-height: 1.3;
    }
    .an-result p {
        color: #4d5156;
        max-width: none;
    }
    .an-code {
        margin-top: auto;
        padding: 0.8rem 1rem;
        border-radius: 10px;
        background: #f6f8fa;
        font-family: var(--font-mono);
        font-size: clamp(0.5rem, 0.9vw, 0.7rem);
        line-height: 1.6;
        color: #57606a;
        white-space: pre-wrap;
        overflow: hidden;
    }
    .an-code .k { color: #0550ae; }
    .an-code .v { color: #1a7f37; }

    /* --- Capa 3: velocidad (tipo "herramientas de desarrollador") --- */
    .an-speed {
        position: absolute;
        inset: 0;
        padding: 6% 6% 5%;
        display: flex;
        flex-direction: column;
        gap: 5%;
        color: #d1d1d6;
        font-size: clamp(0.6rem, 1.15vw, 0.85rem);
    }
    .an-speed-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 600;
    }
    .an-ok {
        padding: 0.25rem 0.7rem;
        border-radius: 99px;
        color: #34c759;
        background: rgba(52, 199, 89, 0.14);
        opacity: 0;
        transition: opacity 0.4s ease 0.75s;
    }
    .an-bars {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }
    .an-bars li {
        display: grid;
        grid-template-columns: 30% 1fr;
        align-items: center;
        gap: 0.8rem;
    }
    .an-bars span {
        color: #8e8e93;
    }
    .an-bars i {
        position: relative;
        display: block;
        height: 10px;
        border-radius: 99px;
        background: rgba(255, 255, 255, 0.05);
    }
    .an-bars i::after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: calc(var(--x) * 100%);
        width: calc(var(--w) * 100%);
        border-radius: 99px;
        background: linear-gradient(90deg, var(--c3), #a78bfa);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.5s var(--ease-out-quart) var(--d);
    }
    .an-axis {
        margin-top: auto;
        display: flex;
        justify-content: space-between;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 0.5rem;
    }
    .an-axis span {
        width: 1px;
        height: 6px;
        background: rgba(255, 255, 255, 0.15);
    }
    /* La carga "se hace" cuando la capa 3 está activa (y queda hecha después) */
    .an-scene[data-activo='3'] .an-bars i::after,
    .an-scene[data-paso='4'] .an-bars i::after {
        transform: scaleX(1);
    }
    .an-scene[data-activo='3'] .an-ok,
    .an-scene[data-paso='4'] .an-ok {
        opacity: 1;
    }

    /* ================= MÓVIL ================= */
    @media (max-width: 860px) {
        .anatomy {
            height: 360vh;
        }
        .an-grid {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto;
            gap: 1.5rem;
            align-content: center;
            height: 100%;
            padding-top: 70px; /* deja sitio a la barra de navegación */
        }
        .an-stage {
            order: -1;
            height: 42svh;
        }
        .an-scene {
            --gap: 70px;
            width: 92%;
        }
        .an-scene[data-activo='2'] {
            --an-up1: 55px;
        }
        .an-scene[data-activo='3'] {
            --an-up1: 95px;
            --an-up2: 55px;
        }
        .an-copy {
            gap: 1rem;
            align-items: flex-start;
        }
        .an-rail {
            flex-direction: column;
            padding-top: 0.4rem;
        }
        .an-steps {
            min-height: 250px;
        }
        .an-step {
            inset: 0 0 auto 0;
            transform: translateY(24px);
            filter: none;
        }
        .an-step.is-active {
            transform: none;
        }
        .an-step.is-past {
            transform: translateY(-24px);
        }
        .an-step h2,
        .an-step h3 {
            font-size: clamp(1.7rem, 7vw, 2.2rem);
            margin-bottom: 0.7rem;
        }
        .an-text {
            font-size: 1rem;
        }
        .an-tag {
            font-size: 0.68rem;
            top: -12px;
            left: 10px;
        }
        .an-l1 .an-tag {
            top: 8px;
        }
        .an-live {
            font-size: 0.65rem;
            left: 8px;
            bottom: 8px;
            padding: 0.3rem 0.6rem;
        }
        .an-bars {
            gap: 0.45rem;
        }
        .an-bars i {
            height: 6px;
        }
        .an-code {
            display: none;
        }
    }

    /* ======== SIN JS / REDUCIR MOVIMIENTO: todo el texto visible, sin scroll largo ======== */
    :global(html:not(.js-motion)) .anatomy {
        height: auto;
    }
    :global(html:not(.js-motion)) .an-sticky {
        position: relative;
        height: auto;
        padding-block: clamp(4rem, 10vh, 7rem);
    }
    :global(html:not(.js-motion)) .an-grid {
        height: auto;
        padding-top: 0;
    }
    :global(html:not(.js-motion)) .an-rail {
        display: none;
    }
    :global(html:not(.js-motion)) .an-steps {
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 2.2rem;
    }
    :global(html:not(.js-motion)) .an-step {
        position: static;
        opacity: 1;
        visibility: visible;
        filter: none;
        transform: none;
    }
    :global(html:not(.js-motion)) .an-stage {
        height: auto;
    }
</style>

<script>
    // @ts-nocheck
    import { gsap, reduceMotion } from '@/lib/motion.js'

    const section = document.getElementById('anatomia')
    const scene = section?.querySelector('.an-scene')
    const steps = section ? [...section.querySelectorAll('.an-step')] : []
    const rail = section ? [...section.querySelectorAll('.an-rail li')] : []
    const glow = section?.querySelector('.an-glow')

    if (section && scene && !reduceMotion) {
        const clamp = (v) => Math.min(1, Math.max(0, v))
        const tramo = (p, a, b) => clamp((p - a) / (b - a))
        const suave = (x) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2)

        // Guion del scroll (0 → 1):
        //  0.00–0.18  web plana (intro)
        //  0.06–0.26  se inclina y se separa en capas
        //  0.20 / 0.42 / 0.62  capa 1 / 2 / 3 activa
        //  0.76–0.92  las capas se vuelven a juntar → web terminada
        const PASOS = [0, 0.2, 0.42, 0.62, 0.8]
        let paso = -1
        let tAntes = ''
        let sAntes = ''

        function pintar(p) {
            const abre = suave(tramo(p, 0.06, 0.24))
            const cierra = suave(tramo(p, 0.76, 0.92))
            const t = abre * (1 - cierra)
            const s = suave(tramo(p, 0.1, 0.26)) * (1 - suave(tramo(p, 0.74, 0.9)))
            // Solo se escribe si cambia: en la mayor parte del recorrido las capas
            // están quietas (t = s = 1) y así el navegador no recalcula nada
            const tTxt = t.toFixed(4)
            const sTxt = s.toFixed(4)
            if (tTxt !== tAntes) {
                scene.style.setProperty('--t', tTxt)
                tAntes = tTxt
            }
            if (sTxt !== sAntes) {
                scene.style.setProperty('--s', sTxt)
                // Directo al brillo (una variable en el contenedor obligaba a
                // recalcular los estilos de toda la escena)
                glow.style.opacity = (0.35 + s * 0.65).toFixed(3)
                scene.classList.toggle('is-abierta', s > 0.4)
                sAntes = sTxt
            }

            let n = 0
            PASOS.forEach((umbral, i) => {
                if (p >= umbral) n = i
            })
            if (n === paso) return // solo se tocan clases cuando cambia el paso
            paso = n
            scene.dataset.paso = String(n)
            scene.dataset.activo = n >= 1 && n <= 3 ? String(n) : '0'
            steps.forEach((el, i) => {
                el.classList.toggle('is-active', i === n)
                el.classList.toggle('is-past', i < n)
            })
            rail.forEach((li, i) => li.classList.toggle('is-on', i === n))
        }

        // Un "proxy" animado con scrub suaviza el movimiento respecto al scroll
        const estado = { p: 0 }
        gsap.to(estado, {
            p: 1,
            ease: 'none',
            scrollTrigger: {
                trigger: section,
                start: 'top top',
                end: 'bottom bottom',
                scrub: 0.8,
            },
            onUpdate: () => pintar(estado.p),
        })
        pintar(0)
    }
</script>
