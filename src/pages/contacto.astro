---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Navbar from '@/components/Navbar.astro'
import Footer from '@/components/Footer.astro'

const seoTitle = 'Contacto — extreweb, tu agencia web'
const seoDesc =
    'Habla directamente con los fundadores de extreweb. Cuéntanos tu proyecto y veamos cómo podemos ayudarte a crecer en internet.'
---

<BaseLayout title={seoTitle} description={seoDesc}>
    <Navbar />

    <main class='page-main'>
        <div class='ambient-glow g-1'></div>

        <section class='contact-sec'>
            <div class='container'>
                <div class='contact-grid'>
                    <!-- LADO IZQUIERDO: Info y Mensaje -->
                    <div class='c-left'>
                        <span class='eyebrow gsap-fade'>¿Hablamos?</span>
                        <h1 class='gsap-reveal'>Cuéntanos tu<br />proyecto.</h1>
                        <p class='c-desc gsap-fade'>
                            Sin compromisos ni chatbots. Cuéntanos qué necesitas
                            y te responderemos en menos de 24 horas. También
                            puedes enviarnos un WhatsApp si lo prefieres.
                        </p>

                        <div class='c-info-list gsap-fade'>
                            <div class='c-info-item'>
                                <span class='c-icon'>✉️</span>
                                <div>
                                    <strong>Email directo</strong>
                                    <a href='mailto:contactoextreweb@gmail.com'
                                        >contactoextreweb@gmail.com</a
                                    >
                                </div>
                            </div>
                            <div class='c-info-item'>
                                <span class='c-icon'>💬</span>
                                <div>
                                    <strong>WhatsApp / Teléfono</strong>
                                    <a
                                        href='https://wa.me/34628775619'
                                        target='_blank'
                                        rel='noopener'>Escríbenos por WhatsApp</a
                                    >
                                    <a href='tel:+34628775619'
                                        >+34 628 775 619</a
                                    >
                                </div>
                            </div>
                            <div class='c-info-item'>
                                <span class='c-icon'>📍</span>
                                <div>
                                    <strong>Dónde estamos</strong>
                                    <span
                                        >Villanueva de la Serena (Badajoz). Trabajamos
                                        en toda Extremadura y online.</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- LADO DERECHO: Formulario Conversacional -->
                    <div class='c-right gsap-up'>
                        <div class='form-card'>
                            <form
                                name='contacto'
                                method='POST'
                                data-netlify='true'
                                netlify-honeypot='bot-field'
                                data-netlify-recaptcha='true'
                                class='extre-form'
                            >
                                <p class='hp-field'>
                                    <label
                                        >No rellenar este campo si eres humano: <input
                                            name='bot-field'
                                        /></label
                                    >
                                </p>

                                <div class='form-group'>
                                    <label for='name'>Me llamo...</label>
                                    <input
                                        type='text'
                                        id='name'
                                        name='name'
                                        placeholder='Tu nombre o empresa'
                                        required
                                    />
                                </div>

                                <div class='form-group'>
                                    <label for='email'>Mi email es...</label>
                                    <input
                                        type='email'
                                        id='email'
                                        name='email'
                                        placeholder='correo@ejemplo.com'
                                        required
                                    />
                                </div>

                                <div class='form-group'>
                                    <label for='service'>Me interesa...</label>
                                    <div class='select-wrapper'>
                                        <select id='service' name='service'>
                                            <option value='web'
                                                >Diseño y Desarrollo Web</option
                                            >
                                            <option value='seo'
                                                >SEO / Posicionamiento</option
                                            >
                                            <option value='social'
                                                >Redes Sociales</option
                                            >
                                            <option value='sistemas'
                                                >Sistemas y Soporte</option
                                            >
                                            <option value='otro'
                                                >Otra consulta</option
                                            >
                                        </select>
                                    </div>
                                </div>

                                <div class='form-group'>
                                    <label for='message'
                                        >Y me gustaría contaros que...</label
                                    >
                                    <textarea
                                        id='message'
                                        name='message'
                                        rows='4'
                                        placeholder='Háblanos un poco de tu negocio y lo que tienes en mente...'
                                        required></textarea>
                                </div>

                                <label class='form-consent'>
                                    <input
                                        type='checkbox'
                                        name='privacidad'
                                        value='acepto'
                                        required
                                    />
                                    <span
                                        >He leído y acepto la <a
                                            href='/privacidad/'
                                            target='_blank'
                                            rel='noopener'>política de privacidad</a
                                        >.</span
                                    >
                                </label>

                                <p class='form-legal'>
                                    <strong>Responsable:</strong> extreweb.
                                    <strong>Finalidad:</strong> responder a tu consulta.
                                    <strong>Legitimación:</strong> tu consentimiento.
                                    <strong>Destinatarios:</strong> no se ceden a
                                    terceros; Netlify (formulario) y Google
                                    reCAPTCHA (antispam) actúan como proveedores
                                    técnicos.
                                    <strong>Derechos:</strong> acceso, rectificación,
                                    supresión y demás, escribiendo a
                                    contactoextreweb@gmail.com.
                                </p>

                                <!-- Netlify sustituye este div por el reCAPTCHA
                                     al desplegar (en local no aparece). -->
                                <div class='form-captcha'>
                                    <div data-netlify-recaptcha='true'></div>
                                </div>

                                <p
                                    class='form-error'
                                    role='alert'
                                    data-captcha-error
                                    hidden
                                >
                                    Marca la casilla «No soy un robot» antes de
                                    enviar.
                                </p>

                                <p
                                    class='form-error'
                                    role='alert'
                                    data-form-error
                                    hidden
                                >
                                    No hemos podido enviar el mensaje. Prueba de
                                    nuevo o escríbenos a <a
                                        href='mailto:contactoextreweb@gmail.com'
                                        >contactoextreweb@gmail.com</a
                                    >.
                                </p>

                                <div class='form-action'>
                                    <button
                                        type='submit'
                                        class='btn btn-accent btn-massive'
                                        data-form-submit
                                    >
                                        <span data-label>Enviar mensaje</span>
                                        <span aria-hidden='true'>→</span>
                                    </button>
                                </div>
                            </form>

                            <!-- Solo se muestra por JS tras un envío correcto.
                                 Sin JS, el formulario hace POST normal y Netlify
                                 muestra su página de confirmación. -->
                            <div
                                class='form-done'
                                data-form-done
                                tabindex='-1'
                                hidden
                            >
                                <span class='done-ico' aria-hidden='true'>✓</span>
                                <h2>Mensaje enviado.</h2>
                                <p>
                                    Gracias por escribirnos. Te respondemos en
                                    menos de 24 horas en el email que nos has
                                    dejado.
                                </p>
                                <button
                                    type='button'
                                    class='btn'
                                    data-form-reset>Enviar otro mensaje</button
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>

<style>
    .page-main {
        background: var(--bg);
        overflow-x: hidden;
        position: relative;
    }

    .ambient-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.15;
        z-index: 0;
        pointer-events: none;
    }
    .g-1 {
        width: 600px;
        height: 600px;
        background: var(--accent);
        top: 0;
        right: -200px;
    }
    html[data-theme='light'] .ambient-glow {
        opacity: 0.08;
    }

    .contact-sec {
        padding: clamp(150px, 20vh, 200px) 0 clamp(80px, 10vh, 120px);
        position: relative;
        z-index: 10;
        min-height: 90vh;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(4rem, 8vw, 8rem);
        align-items: start;
    }

    /* --- LADO IZQUIERDO --- */
    .eyebrow {
        color: var(--accent);
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        display: block;
        margin-bottom: 2rem;
    }
    .c-left h1 {
        font-size: clamp(3rem, 6vw, 5.5rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.05;
        margin-bottom: 2rem;
        color: var(--fg);
    }
    .c-desc {
        font-size: clamp(1.2rem, 2vw, 1.4rem);
        line-height: 1.6;
        color: var(--muted);
        margin-bottom: 4rem;
        max-width: 500px;
    }

    .c-info-list {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }
    .c-info-item {
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
    }
    .c-icon {
        font-size: 2rem;
        line-height: 1;
        background: var(--surface);
        padding: 1rem;
        border-radius: 20px;
        border: 1px solid var(--border);
    }
    .c-info-item div {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }
    .c-info-item strong {
        font-size: 1.1rem;
        color: var(--fg);
    }
    .c-info-item a,
    .c-info-item span {
        font-size: 1.2rem;
        color: var(--muted);
        text-decoration: none;
        transition: color 0.3s ease;
    }
    @media (hover: hover) and (pointer: fine) {
        .c-info-item a:hover {
            color: var(--accent);
        }
    }

    /* --- LADO DERECHO (FORMULARIO) --- */
    .form-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 32px;
        padding: clamp(2.5rem, 5vw, 4rem);
        box-shadow: var(--shadow-lg);
    }

    .extre-form {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }
    .extre-form[hidden] {
        display: none;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .form-group label {
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--fg);
        letter-spacing: -0.02em;
    }

    .extre-form input,
    .extre-form textarea,
    .extre-form select {
        width: 100%;
        background: var(--bg);
        border: 2px solid var(--border);
        border-radius: 16px;
        padding: 1.2rem 1.5rem;
        font-family: var(--font);
        font-size: 1.1rem;
        color: var(--fg);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .extre-form input:focus,
    .extre-form textarea:focus,
    .extre-form select:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 15%, transparent);
        transform: translateY(-2px);
    }

    .extre-form textarea {
        resize: vertical;
        min-height: 120px;
    }

    .select-wrapper {
        position: relative;
    }
    .select-wrapper::after {
        content: '↓';
        position: absolute;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.2rem;
        color: var(--muted);
        pointer-events: none;
    }
    .extre-form select {
        appearance: none;
        padding-right: 3rem;
        cursor: pointer;
    }

    /* Consentimiento RGPD: el label entero es zona táctil */
    .form-consent {
        display: flex;
        align-items: flex-start;
        gap: 0.8rem;
        font-size: 1rem;
        line-height: 1.5;
        color: var(--fg);
        cursor: pointer;
        margin-top: -0.5rem;
    }
    .extre-form .form-consent input {
        flex-shrink: 0;
        width: 1.35rem;
        height: 1.35rem;
        margin-top: 0.1rem;
        padding: 0;
        accent-color: var(--accent);
        cursor: pointer;
    }
    .extre-form .form-consent input:focus {
        transform: none;
        box-shadow: none;
    }
    .extre-form .form-consent input:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }
    .form-consent a,
    .form-error a {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .form-legal {
        font-size: 0.8rem;
        line-height: 1.55;
        color: var(--muted);
        margin-top: -1.2rem;
    }
    .form-legal strong {
        font-weight: 600;
    }

    .form-error {
        font-size: 0.95rem;
        line-height: 1.5;
        color: #d70015;
        background: color-mix(in srgb, #ff3b30 10%, transparent);
        border-radius: var(--radius);
        padding: 0.9rem 1.1rem;
    }
    html[data-theme='dark'] .form-error {
        color: #ff6961;
    }
    .form-error[hidden] {
        display: none;
    }

    /* El widget de Google mide 304×78 fijo: se escala para que quepa en móvil */
    .form-captcha {
        min-height: 78px;
        margin-top: -0.8rem;
    }
    @media (max-width: 400px) {
        .form-captcha {
            min-height: 71px;
        }
        .form-captcha > div {
            transform: scale(0.9);
            transform-origin: left top;
        }
    }
    @media (max-width: 340px) {
        .form-captcha {
            min-height: 62px;
        }
        .form-captcha > div {
            transform: scale(0.78);
        }
    }

    .form-action {
        margin-top: 0.5rem;
    }
    .btn-massive {
        width: 100%;
        justify-content: center;
        font-size: 1.3rem;
        padding: 1.2rem 2rem;
        border-radius: 20px;
    }
    .btn-massive:disabled {
        opacity: 0.6;
        cursor: progress;
        transform: none;
    }

    /* --- ESTADO ENVIADO --- */
    .form-done {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.2rem;
        outline: none;
        animation: doneIn var(--dur-slow) var(--ease-out-expo);
    }
    .form-done[hidden] {
        display: none;
    }
    .done-ico {
        display: grid;
        place-items: center;
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 50%;
        background: var(--accent);
        color: var(--accent-fg);
        font-size: 1.6rem;
        font-weight: 700;
    }
    .form-done h2 {
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        letter-spacing: -0.03em;
        color: var(--fg);
    }
    .form-done p {
        font-size: 1.1rem;
        line-height: 1.6;
        color: var(--muted);
    }
    .form-done .btn {
        background: var(--bg);
        border: 1px solid var(--border);
        min-height: 48px;
    }
    @media (hover: hover) and (pointer: fine) {
        .form-done .btn:hover {
            border-color: var(--accent);
        }
    }
    @keyframes doneIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
    }

    /* --- RESPONSIVE --- */
    @media (max-width: 900px) {
        .contact-grid {
            grid-template-columns: 1fr;
            gap: 5rem;
        }
        .form-card {
            padding: 2rem;
            border-radius: 24px;
        }
    }
    @media (max-width: 480px) {
        .form-card {
            padding: 1.5rem 1.25rem;
        }
        .extre-form {
            gap: 2rem;
        }
        .form-group label {
            font-size: 1.15rem;
        }
        .extre-form input,
        .extre-form textarea,
        .extre-form select {
            padding: 1rem 1.1rem;
        }
        .extre-form select {
            padding-right: 2.6rem;
        }
        .select-wrapper::after {
            right: 1.1rem;
        }
        .btn-massive {
            font-size: 1.15rem;
            padding: 1.1rem 1.5rem;
        }
    }
</style>

<script>
    // @ts-nocheck
    import { gsap } from '@/lib/motion.js'

    document.addEventListener('DOMContentLoaded', () => {
        gsap.from('.gsap-reveal', {
            y: 40,
            opacity: 0,
            duration: 1,
            ease: 'power4.out',
            delay: 0.1,
        })
        gsap.from('.gsap-fade', {
            y: 20,
            opacity: 0,
            duration: 1,
            stagger: 0.15,
            ease: 'power3.out',
            delay: 0.2,
        })
        gsap.from('.gsap-up', {
            y: 60,
            opacity: 0,
            duration: 1.2,
            ease: 'power4.out',
            delay: 0.4,
        })
    })

    // --- Envío del formulario a Netlify Forms sin salir de la página ---
    // Sin JS el <form> hace POST normal y Netlify muestra su confirmación,
    // así que esto solo mejora la experiencia; nunca es requisito.
    const form = document.querySelector('form[name="contacto"]')
    const done = document.querySelector('[data-form-done]')
    const errorBox = document.querySelector('[data-form-error]')
    const captchaError = document.querySelector('[data-captcha-error]')
    const submitBtn = form?.querySelector('[data-form-submit]')
    const submitLabel = submitBtn?.querySelector('[data-label]')

    // Si viene del configurador de la home, dejamos el mensaje empezado (una sola vez)
    try {
        const raw = sessionStorage.getItem('ew-configurador')
        if (raw && form) {
            sessionStorage.removeItem('ew-configurador')
            const c = JSON.parse(raw)
            const msg = form.querySelector('#message')
            const servicio = form.querySelector('#service')
            if (msg && !msg.value) {
                // "galería, opiniones y WhatsApp"
                const lista = (a) =>
                    a.length > 1 ? `${a.slice(0, -1).join(', ')} y ${a.at(-1)}` : a[0] || ''
                const estilo = c.estilo ? ` y estilo ${c.estilo}` : ''
                const extras = c.extras?.length ? `, con ${lista(c.extras)}` : ''
                msg.value = `Hola, tengo ${c.articulo} («${c.nombre}») y me gustaría una web como la que he probado en vuestro configurador: color ${c.color}${estilo}${extras}. `
            }
            if (servicio) servicio.value = 'web'
        }
    } catch (e) {}

    // Los tokens de reCAPTCHA son de un solo uso: tras cada intento se reinicia
    const resetCaptcha = () => {
        try {
            window.grecaptcha?.reset()
        } catch (e) {}
    }

    form?.addEventListener('submit', async (e) => {
        e.preventDefault()
        errorBox.hidden = true
        captchaError.hidden = true

        // Solo existe cuando Netlify ha inyectado el reCAPTCHA (en producción)
        const captcha = form.querySelector('[name="g-recaptcha-response"]')
        if (captcha && !captcha.value) {
            captchaError.hidden = false
            return
        }

        submitBtn.disabled = true
        submitLabel.textContent = 'Enviando…'

        const data = new FormData(form)
        // form.name devolvería el <input name="name">, por eso getAttribute
        data.set('form-name', form.getAttribute('name'))

        try {
            const res = await fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(data).toString(),
            })
            if (!res.ok) throw new Error('HTTP ' + res.status)

            form.reset()
            form.hidden = true
            done.hidden = false
            // El formulario encoge al ocultarse: llevamos la vista al mensaje
            done.focus({ preventScroll: true })
            if (window.__lenis) window.__lenis.scrollTo(done, { offset: -140 })
            else done.scrollIntoView({ block: 'center' })
        } catch (err) {
            console.error('[contacto] Error al enviar:', err)
            errorBox.hidden = false
        } finally {
            resetCaptcha()
            submitBtn.disabled = false
            submitLabel.textContent = 'Enviar mensaje'
        }
    })

    document.querySelector('[data-form-reset]')?.addEventListener('click', () => {
        done.hidden = true
        form.hidden = false
        form.querySelector('#name')?.focus()
    })
</script>
