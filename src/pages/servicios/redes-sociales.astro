---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Navbar from '@/components/Navbar.astro'
import Cta from '@/components/Cta.astro'
import Footer from '@/components/Footer.astro'
import ServiceSchema from '@/components/seo/ServiceSchema.astro'
import RedesAnimadas from '@/components/RedesAnimadas.astro'

const seoTitle = 'Gestión de Redes Sociales en Extremadura — extreweb'
const seoDesc =
    'Atrae, conecta y fideliza a tu audiencia. Gestionamos tus redes sociales con estrategias reales para negocios locales y regionales.'
---

<BaseLayout title={seoTitle} description={seoDesc}>
    <ServiceSchema
        name='Gestión de redes sociales'
        description={seoDesc}
        slug='/servicios/redes-sociales'
    />
    <Navbar />
    <main class='page-main'>
        <div class='ambient-glow g-1'></div>

        <section class='svc-hero text-center'>
            <div class='container'>
                <a href='/servicios/' class='back-link fx-in-soft'
                    >← Todos los servicios</a
                >
                <h1 class='fx-in'>
                    Gestión de<br /><span class='text-accent'
                        >Redes Sociales.</span>
                </h1>
                <p class='hero-desc fx-in-soft'>
                    Tu comunidad te está buscando. Diseñamos estrategias de
                    contenido, gestionamos tus perfiles y creamos anuncios (Ads)
                    para que tu marca destaque y atraiga clientes reales.
                </p>
            </div>
        </section>

        <RedesAnimadas />

        <Cta />
    </main>
    <Footer />
</BaseLayout>

<style>
    .page-main {
        background: var(--bg);
        overflow-x: hidden;
        position: relative;
    }
    .text-center {
        text-align: center;
    }

    .ambient-glow {
        position: absolute;
        border-radius: 50%;
        /* Degradado en vez de filter: blur(120px): mismo halo, pero sin
           recalcular un desenfoque enorme cada vez que se repinta la zona */
        -webkit-mask-image: radial-gradient(closest-side, #000 20%, transparent);
        mask-image: radial-gradient(closest-side, #000 20%, transparent);
        scale: 1.7;
        opacity: 0.15;
        z-index: 0;
        pointer-events: none;
    }
    .g-1 {
        width: 600px;
        height: 600px;
        background: var(--accent);
        top: -100px;
        left: 50%;
        transform: translateX(-50%);
    }
    html[data-theme='light'] .ambient-glow {
        opacity: 0.08;
    }

    .svc-hero {
        padding: clamp(160px, 20vh, 220px) 0 clamp(60px, 10vh, 100px);
        position: relative;
        z-index: 10;
    }
    .back-link {
        color: var(--muted);
        text-decoration: none;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 2rem;
        transition: color 0.3s;
    }
    .back-link:hover {
        color: var(--accent);
    }
    .svc-hero h1 {
        font-size: clamp(3rem, 6vw, 5.5rem);
        font-weight: 800;
        line-height: 1.05;
        margin-bottom: 2rem;
        color: var(--fg);
    }
    .hero-desc {
        font-size: clamp(1.2rem, 2vw, 1.4rem);
        line-height: 1.6;
        color: var(--muted);
        max-width: 700px;
        margin: 0 auto;
    }
</style>
